#!/usr/bin/env python3
import os
import subprocess
import sys

W, H = 22, 22
GAP = 4


def sh(cmd):
    env = dict(os.environ, LANG="C", LC_ALL="C")
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4,
                              env=env).stdout.strip()
    except Exception:
        return ""


def panel_dark():
    props = sh(["xfconf-query", "-c", "xfce4-panel", "-l"])
    for p in props.splitlines():
        if p.endswith("/dark-mode"):
            return sh(["xfconf-query", "-c", "xfce4-panel", "-p", p]) == "true"
    return True


def net_state():
    out = sh(["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device", "status"])
    for line in out.splitlines():
        p = line.split(":")
        if len(p) >= 3 and p[1] == "connected":
            return p[0], p[2]
    return None, None


def volume_state():
    out = sh(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
    vol = 0
    for tok in out.split():
        if tok.endswith("%"):
            try:
                vol = int(tok[:-1])
            except ValueError:
                pass
    mute = "yes" in sh(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
    return vol, mute


def battery_state():
    for name in os.listdir("/sys/class/power_supply"):
        if not name.startswith("BAT"):
            continue
        base = "/sys/class/power_supply/" + name
        try:
            cap = int(open(base + "/capacity").read().strip())
        except Exception:
            continue
        try:
            status = open(base + "/status").read().strip()
        except Exception:
            status = ""
        return cap, status
    return None, ""


def svg(color, net_type, vol, mute, cap):
    parts = []
    x = 0
    if net_type == "ethernet":
        parts.append(f'<g transform="translate({x},0)" fill="{color}">')
        parts.append('<rect x="4" y="8" width="14" height="8" rx="2"/>')
        parts.append('<rect x="6" y="4" width="2" height="5" rx="1"/>')
        parts.append('<rect x="10" y="4" width="2" height="5" rx="1"/>')
        parts.append('<rect x="14" y="4" width="2" height="5" rx="1"/>')
        parts.append('</g>')
    else:
        opacity = "1" if net_type == "wifi" else "0.35"
        parts.append(f'<g transform="translate({x},0)" opacity="{opacity}" fill="none" stroke="{color}" stroke-width="1.7" stroke-linecap="round">')
        parts.append(f'<circle cx="11" cy="16.5" r="1.3" fill="{color}" stroke="none"/>')
        parts.append('<path d="M6.8 13.4a6.3 6.3 0 0 1 8.4 0"/>')
        parts.append('<path d="M3.8 10.2a10.6 10.6 0 0 1 14.4 0"/>')
        parts.append('</g>')

    x = W + GAP
    if cap is None:
        parts.append(f'<g transform="translate({x},0)" fill="none" stroke="{color}" stroke-width="1.5" opacity="0.35">')
        parts.append('<rect x="3" y="7" width="14" height="9" rx="2"/>')
        parts.append('</g>')
    else:
        fillw = max(2, int(12 * cap / 100))
        fill = "#4caf50" if cap > 30 else ("#ff9800" if cap > 15 else "#f44336")
        parts.append(f'<g transform="translate({x},0)">')
        parts.append(f'<rect x="3" y="7" width="14" height="9" rx="2" fill="none" stroke="{color}" stroke-width="1.5"/>')
        parts.append(f'<rect x="5" y="9" width="{fillw}" height="5" rx="1" fill="{fill}"/>')
        parts.append(f'<rect x="18" y="9.5" width="2" height="4" rx="1" fill="{color}"/>')
        parts.append('</g>')

    x = 2 * (W + GAP)
    parts.append(f'<g transform="translate({x},0)" fill="{color}">')
    parts.append('<path d="M4 8.5h3l4.5-3.5v12L7 13.5H4z"/>')
    if mute or vol == 0:
        parts.append(f'<path d="M13.5 8.5l5 5M18.5 8.5l-5 5" fill="none" stroke="#f44336" stroke-width="1.7" stroke-linecap="round"/>')
    else:
        if vol >= 34:
            parts.append(f'<path d="M13.5 8a4.2 4.2 0 0 1 0 6" fill="none" stroke="{color}" stroke-width="1.6" stroke-linecap="round"/>')
        if vol >= 67:
            parts.append(f'<path d="M15.8 5.8a8 8 0 0 1 0 10.4" fill="none" stroke="{color}" stroke-width="1.6" stroke-linecap="round"/>')
    parts.append('</g>')

    total_w = 3*W + 2*GAP
    scale = 28.0 / H
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{total_w*scale:.1f}" height="28" '
            f'viewBox="0 0 {total_w} {H}">' + "".join(parts) + '</svg>')


def main():
    if "--svg" in sys.argv:
        color = sys.argv[sys.argv.index("--svg") + 1]
        net_type, _ = net_state()
        vol, mute = volume_state()
        cap, _ = battery_state()
        sys.stdout.write(svg(color, net_type, vol, mute, cap))
        return

    color = "#dfdfdf" if panel_dark() else "#444444"
    net_type, net_name = net_state()
    vol, mute = volume_state()
    cap, status = battery_state()

    out = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "dapeos-status.svg")
    with open(out, "w", encoding="utf-8") as f:
        f.write(svg(color, net_type, vol, mute, cap))

    if net_type == "ethernet":
        net_txt = f"Kabel: {net_name}"
    elif net_type == "wifi":
        net_txt = f"Wi-Fi: {net_name}"
    else:
        net_txt = "Nepřipojeno"
    vol_txt = "zvuk: ztlumeno" if mute else f"zvuk: {vol}%"
    bat_txt = f"baterie: {cap}% ({status})" if cap is not None else "bez baterie"

    print(f"<img>{out}</img>")
    if os.path.exists("/tmp/dapeos-quicksettings-open"):
        print("<tool></tool>")
    else:
        print(f"<tool>{net_txt} | {vol_txt} | {bat_txt}</tool>")
    print("<click>dapeos-quicksettings-toggle</click>")


if __name__ == "__main__":
    main()
