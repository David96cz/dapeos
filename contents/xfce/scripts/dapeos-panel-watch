#!/bin/sh
# Restartuje panel po zmene dark-mode nebo motivu/ikon (whiskermenu ikony).
exec 9>/tmp/dapeos-panel-watch.lock
flock -n 9 || exit 0

restart_panel() {
    /usr/local/bin/dapeos-panel-restart
}

watch_channel() {
    xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *IconThemeName*)
                ;;
            *ThemeName*)
                dapeos-theme-sync
                ;;
            *dark-mode*)
                sleep 0.4
                restart_panel
                ;;
        esac
    done
}

watch_dark_poll() {
    local last
    last=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
    while :; do
        sleep 1
        local now
        now=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
        if [ "$now" != "$last" ]; then
            last="$now"
            sleep 0.3
            restart_panel
        fi
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
watch_dark_poll &
wait
