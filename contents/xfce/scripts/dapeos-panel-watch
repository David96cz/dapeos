#!/bin/sh
# Restartuje panel po zmene dark-mode nebo motivu/ikon (whiskermenu ikony).
exec 9>/tmp/dapeos-panel-watch.lock
flock -n 9 || exit 0

restart_panel() {
    pkill -x xfce4-panel 2>/dev/null
    pkill -x nm-applet 2>/dev/null
    pkill -x blueman-applet 2>/dev/null
    sleep 0.5
    setsid /usr/local/bin/xfce4-panel >/dev/null 2>&1 < /dev/null &
    dapeos-touchpad >/dev/null 2>&1 &
}

watch_channel() {
    xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *dark-mode*|*ThemeName*|*IconThemeName*)
                sleep 0.4
                restart_panel
                ;;
        esac
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
wait
