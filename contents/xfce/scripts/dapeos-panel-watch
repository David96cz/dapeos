#!/bin/sh
# Long-running xfconf watcher; survive xfconf-query monitor exits.
set -eu
exec 9>/tmp/dapeos-panel-watch.lock
flock -n 9 || exit 0

restart_panel() {
    /usr/local/bin/dapeos-panel-restart
}

watch_channel() {
    while :; do
        xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
            case "$line" in
                *IconThemeName*)
                    cur="$(xfconf-query -c xsettings -p /Net/IconThemeName 2>/dev/null || true)"
                    [ "$cur" = "DapeOS" ] || xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
                    ;;
                *ThemeName*)
                    dapeos-theme-sync
                    ;;
                *dark-mode*)
                    sleep 0.4
                    restart_panel
                    ;;
            esac
        done
        sleep 1
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
wait
