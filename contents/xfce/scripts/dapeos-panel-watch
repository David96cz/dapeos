#!/bin/sh
# Restartuje panel po zmene dark-mode nebo motivu/ikon (whiskermenu ikony).
exec 9>/tmp/dapeos-panel-watch.lock
flock -n 9 || exit 0

restart_panel() {
    local reopen=0
    pgrep -f 'xfce4-panel --settings' >/dev/null 2>&1 && reopen=1
    for _p in $(pgrep -f '^/usr/bin/xfce4-panel' 2>/dev/null); do
        kill -9 "$_p" 2>/dev/null || true
    done
    pkill -x xfce4-clipman 2>/dev/null
    pkill -x nm-applet 2>/dev/null
    pkill -x blueman-applet 2>/dev/null
    sleep 0.5
    setsid /usr/local/bin/xfce4-panel >/dev/null 2>&1 < /dev/null &
    dapeos-touchpad >/dev/null 2>&1 &
    if [ "$reopen" = "1" ]; then
        sleep 0.3
        setsid /usr/local/bin/xfce4-panel --settings >/dev/null 2>&1 < /dev/null &
    fi
}

watch_channel() {
    xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
        printf '%s %s: %s\n' "$(date +%H:%M:%S)" "$1" "$line" >> /tmp/dapeos-panel-watch.log
        case "$line" in
            *ThemeName*)
                dapeos-theme-sync
                ;;
            *dark-mode*)
                sleep 0.4
                restart_panel
                ;;
            *IconThemeName*)
                ;;
        esac
    done
}

watch_dark_poll() {
    local last
    last=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
    while :; do
        sleep 1
        local now
        now=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
        if [ "$now" != "$last" ]; then
            last="$now"
            sleep 0.3
            restart_panel
        fi
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
watch_dark_poll &
wait
