#!/bin/sh
# Restartuje panel po zmene dark-mode nebo motivu/ikon (whiskermenu ikony).
exec 9>/tmp/dapeos-panel-watch.lock
flock -n 9 || exit 0

restart_panel() {
    pkill -9 -f '[d]apeos-quicksettings' 2>/dev/null || true
    local reopen=0
    pgrep -f 'xfce4-panel --settings' >/dev/null 2>&1 && reopen=1
    pkill -x xfce4-panel 2>/dev/null
    pkill -x xfce4-clipman 2>/dev/null
    pkill -x nm-applet 2>/dev/null
    pkill -x blueman-applet 2>/dev/null
    sleep 0.5
    setsid /usr/local/bin/xfce4-panel >/dev/null 2>&1 < /dev/null &
    dapeos-touchpad >/dev/null 2>&1 &
    if [ "$reopen" = "1" ]; then
        sleep 0.3
        setsid /usr/local/bin/xfce4-panel --settings >/dev/null 2>&1 < /dev/null &
    fi
}

watch_channel() {
    xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *IconThemeName*)
                ;;
            *ThemeName*)
                dapeos-theme-sync
                ;;
            *dark-mode*)
                sleep 0.4
                restart_panel
                ;;
        esac
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
wait
