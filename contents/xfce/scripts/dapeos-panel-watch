#!/bin/sh
# Restartuje panel po zmene dark-mode nebo motivu/ikon (whiskermenu ikony).
exec 9>/tmp/dapeos-panel-watch.lock
if ! flock -n 9; then
    rm -f /tmp/dapeos-panel-watch.lock
    exec 9>/tmp/dapeos-panel-watch.lock
    if ! flock -n 9; then
        echo "$(date +%H:%M:%S) watcher: lock busy, exiting" >> /tmp/dapeos-panel-watch.log
        exit 0
    fi
fi
echo "$(date +%H:%M:%S) watcher: started pid=$$" >> /tmp/dapeos-panel-watch.log

restart_panel() {
    /usr/local/bin/dapeos-panel-restart
}

watch_channel() {
    exec 9>&-
    xfconf-query -c "$1" -m 2>/dev/null | while IFS= read -r line; do
        printf '%s %s: %s\n' "$(date +%H:%M:%S)" "$1" "$line" >> /tmp/dapeos-panel-watch.log
        case "$line" in
            *ThemeName*)
                dapeos-theme-sync
                ;;
            *dark-mode*)
                sleep 0.4
                restart_panel
                ;;
            *IconThemeName*)
                ;;
        esac
    done
}

watch_dark_poll() {
    exec 9>&-
    local last
    last=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
    while :; do
        sleep 1
        local now
        now=$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)
        if [ "$now" != "$last" ]; then
            last="$now"
            echo "$(date +%H:%M:%S) dark-mode $now -> restart" >> /tmp/dapeos-panel-watch.log
            sleep 0.3
            restart_panel
        fi
    done
}

watch_channel xfce4-panel &
watch_channel xsettings &
watch_dark_poll &
wait
