#!/bin/sh
printf '%s wrapper=%s args=%s\n' "$(date +%H:%M:%S)" "$0" "$*" >> /tmp/dapeos-panel-wrapper.log 2>/dev/null || true
lib=/usr/local/lib/dapeos/panel-icons.so
[ -f "$lib" ] || lib=/usr/local/lib/debiconf/panel-icons.so
[ -f "$lib" ] && export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"

dark=false
panel_mode=""
for prop in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep '/dark-mode$'); do
    case "$prop" in
        /panels/panel-*/*) panel_mode="$(xfconf-query -c xfce4-panel -p "$prop" 2>/dev/null || true)" ;;
    esac
done
[ -n "$panel_mode" ] || panel_mode="$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)"
[ "$panel_mode" = "true" ] && dark=true

if command -v dapeos-icon-sync >/dev/null 2>&1; then
    printf '%s icon-sync-start\n' "$(date +%H:%M:%S)" >> /tmp/dapeos-panel-wrapper.log 2>/dev/null || true
    timeout 8 dapeos-icon-sync >/dev/null 2>&1 || true
    printf '%s icon-sync-done\n' "$(date +%H:%M:%S)" >> /tmp/dapeos-panel-wrapper.log 2>/dev/null || true
fi

theme_ready() {
    [ -f "$1/index.theme" ] && [ -e "$1/scalable/search.svg" ]
}

if [ "$dark" = "true" ]; then
    export GTK_THEME=Adwaita:dark
else
    export GTK_THEME=Adwaita:light
fi

panel_theme="$HOME/.local/share/icons/DapeOS-Panel"
i=0
while [ "$i" -lt 20 ] && ! theme_ready "$panel_theme"; do
    sleep 0.1
    i=$((i + 1))
done
if theme_ready "$panel_theme"; then
    export PANEL_ICON_THEME=DapeOS-Panel
    export PANEL_ICONS_FORCE=1
else
    export PANEL_ICON_THEME=DapeOS
fi
printf '%s dark=%s theme=%s\n' "$(date +%H:%M:%S)" "$dark" "$PANEL_ICON_THEME" >> /tmp/dapeos-panel-icons.log 2>/dev/null || true

if [ -x /usr/bin/xfce4-panel.actual ]; then
    exec /usr/bin/xfce4-panel.actual "$@"
elif [ -x /usr/bin/xfce4-panel.realbin ]; then
    exec /usr/bin/xfce4-panel.realbin "$@"
elif [ -x /usr/bin/xfce4-panel.orig ]; then
    exec /usr/bin/xfce4-panel.orig "$@"
elif [ -x /usr/bin/xfce4-panel.bin ]; then
    exec /usr/bin/xfce4-panel.bin "$@"
elif [ -x /usr/bin/xfce4-panel.real ]; then
    exec /usr/bin/xfce4-panel.real "$@"
fi
exec /usr/bin/xfce4-panel "$@"
