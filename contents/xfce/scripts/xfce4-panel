#!/bin/sh
lib=/usr/local/lib/dapeos/panel-icons.so
[ -f "$lib" ] || lib=/usr/local/lib/debiconf/panel-icons.so
[ -f "$lib" ] && export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"

dark=false
for prop in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep '/dark-mode$'); do
    [ "$(xfconf-query -c xfce4-panel -p "$prop" 2>/dev/null)" = "true" ] && dark=true
done

theme_ready() {
    [ -f "$1/index.theme" ] && [ -e "$1/scalable/search.svg" ]
}

if [ "$dark" = "true" ]; then
    export GTK_THEME=Adwaita:dark
    theme=Papirus-Panel
    fallback=Papirus-Dark
else
    export GTK_THEME=Adwaita:light
    theme=Papirus-Panel-Light
    fallback=Papirus-Light
fi

i=0
while [ "$i" -lt 20 ] && ! theme_ready "/usr/share/icons/$theme"; do
    sleep 0.1
    i=$((i + 1))
done
if ! theme_ready "/usr/share/icons/$theme"; then
    theme="$fallback"
fi
export PANEL_ICON_THEME="$theme"

if [ -x /usr/bin/xfce4-panel.orig ]; then
    exec /usr/bin/xfce4-panel.orig "$@"
elif [ -x /usr/bin/xfce4-panel.bin ]; then
    exec /usr/bin/xfce4-panel.bin "$@"
elif [ -x /usr/bin/xfce4-panel.real ]; then
    exec /usr/bin/xfce4-panel.real "$@"
fi
exec /usr/bin/xfce4-panel "$@"
