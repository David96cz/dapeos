#!/usr/bin/env python3
import socket
import subprocess
import sys

SOCK = "/tmp/dapeos-osd"
cmd = sys.argv[1] if len(sys.argv) > 1 else "volume-up"

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.5)
    s.connect(SOCK)
    s.sendall(cmd.encode())
    s.close()
except OSError:
    subprocess.Popen(["dapeos-osd"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    import time
    time.sleep(0.6)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(SOCK)
        s.sendall(cmd.encode())
        s.close()
    except OSError:
        pass
