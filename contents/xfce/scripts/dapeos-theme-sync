#!/bin/sh
exec 7>/tmp/dapeos-theme-sync.lock
flock -w 10 7 || exit 0
# Sync the single DapeOS icon theme with the GTK theme.
theme="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || echo Adwaita)"
case "$theme" in
    *[Dd]ark*) dark=true ;;
    *)         dark=false ;;
esac

if command -v dapeos-system-icon-switch >/dev/null 2>&1; then
    dapeos-system-icon-switch || true
elif command -v dapeos-icon-sync >/dev/null 2>&1; then
    dapeos-icon-sync || true
fi

# Never let the standalone clipman daemon block the panel plugin.
pkill -x xfce4-clipman 2>/dev/null || true
