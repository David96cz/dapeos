#!/bin/sh
# Sync Papirus icon theme with the GTK theme (panel dark mode is independent).
theme="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || echo Adwaita)"
case "$theme" in
    *[Dd]ark*) dark=true; icon="Papirus-Dark" ;;
    *)         dark=false; icon="Papirus-Light" ;;
esac

if command -v dapeos-icon-sync >/dev/null 2>&1; then
    dapeos-icon-sync || true
else
    xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
fi
xfconf-query -c xsettings -p /Gtk/ApplicationPreferDarkTheme -n -t bool -s "$dark" 2>/dev/null || \
    xfconf-query -c xsettings -p /Gtk/ApplicationPreferDarkTheme -s "$dark" 2>/dev/null || true

# Never let the standalone clipman daemon block the panel plugin.
pkill -x xfce4-clipman 2>/dev/null || true
