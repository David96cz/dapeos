#!/usr/bin/env python3
# DapeOS Nastavení - jeden hub pro všechny XFCE nastavovací dialogy.
import glob
import json
import fcntl
import os
import shlex
import time
import subprocess
import sys

from PyQt5.QtCore import QSize, Qt
from PyQt5.QtGui import QIcon
from PyQt5.QtWidgets import (QApplication, QGridLayout, QLabel, QLineEdit,
                             QPushButton, QScrollArea, QSizePolicy, QVBoxLayout, QWidget)
try:
    from PyQt5.QtNetwork import QLocalServer, QLocalSocket
except Exception:  # noqa: BLE001
    QLocalServer = QLocalSocket = None

try:
    from dapeos_i18n import _
except Exception:  # noqa: BLE001
    _ = lambda s: s


try:
    from dapeos_theme import apply_theme, install_theme_watch
except Exception:  # noqa: BLE001
    apply_theme = lambda app=None: False
    install_theme_watch = lambda app=None: None
DIRS = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"]
HIDE_CONF = "/usr/share/dapeos/settings-hide.conf"


def hidden_names():
    try:
        with open(HIDE_CONF, encoding="utf-8") as f:
            return {line.strip() for line in f if line.strip() and not line.startswith("#")}
    except OSError:
        return set()

HIDDEN = {
    "xfce4-settings-manager.desktop",
    "xfce-settings-manager.desktop",
}

GROUPS = ["Appearance", "Hardware", "System", "Personal", "Other"]


def parse(path):
    name = name_cs = icon = exec_line = categories = wmclass = ""
    section = None
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            for raw in f:
                line = raw.strip()
                if line.startswith("["):
                    section = line
                    continue
                if section != "[Desktop Entry]" or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                if k == "Name":
                    name = v
                elif k == "Name[cs]":
                    name_cs = v
                elif k == "Icon":
                    icon = v
                elif k == "Exec":
                    exec_line = v
                elif k == "Categories":
                    categories = v
                elif k == "StartupWMClass":
                    wmclass = v
    except OSError:
        return None
    if not exec_line:
        return None
    cat = categories
    base = os.path.basename(path)
    if base in ("lightdm-settings.desktop",):
        group = "Personal"
    elif base in ("user-manager.desktop", "thunar-settings.desktop"):
        group = "System"
    elif "HardwareSettings" in cat:
        group = "Hardware"
    elif "PersonalSettings" in cat:
        group = "Personal"
    elif "SystemSettings" in cat:
        group = "System"
    elif "DesktopSettings" in cat:
        group = "Appearance"
    elif "Settings" in cat:
        group = "System"
    else:
        group = "Other"
    use_cs = os.environ.get("LANG", "").startswith("cs")
    display = (name_cs if use_cs else name) or name or name_cs or os.path.basename(path)
    titles = [x for x in (name, name_cs, display) if x]
    return {"name": display,
            "titles": titles,
            "icon": icon or "preferences-system",
            "exec": exec_line, "wmclass": wmclass, "group": group, "file": os.path.basename(path)}


def collect():
    items, seen = [], set()
    hidden = hidden_names()
    for d in DIRS:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            try:
                with open(path, encoding="utf-8", errors="ignore") as f:
                    text = f.read()
            except OSError:
                continue
            if "X-XFCE-SettingsDialog" not in text:
                continue
            base = os.path.basename(path)
            if base in seen or base in HIDDEN or base in hidden:
                continue
            data = parse(path)
            if data:
                seen.add(base)
                items.append(data)
    return sorted(items, key=lambda x: x["name"].lower())


class SettingsHub(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_("Settings"))
        self.setWindowIcon(QIcon.fromTheme("preferences-system"))
        self.setFixedSize(860, 620)
        self.items = collect()
        self.buttons = []
        self.button_map = {}
        self._visible = []

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 18)
        root.setSpacing(12)

        title = QLabel(_("Settings"))
        title.setStyleSheet("font-size: 18pt; font-weight: bold;")
        root.addWidget(title)

        self.search = QLineEdit()
        self.search.setPlaceholderText(_("Search settings…"))
        self.search.setStyleSheet("padding: 8px; border: 1px solid #bbb; border-radius: 6px;")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self.filter)
        self.search.returnPressed.connect(self.open_single)
        root.addWidget(self.search)

        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QScrollArea.NoFrame)
        area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        inner = QWidget()
        self.grid = QGridLayout(inner)
        self.grid.setSpacing(8)
        area.setWidget(inner)
        root.addWidget(area, 1)

        self.header_labels = {}
        for group in GROUPS:
            lbl = QLabel(_(group))
            lbl.setStyleSheet("font-size: 11pt; font-weight: bold; padding-top: 8px;")
            lbl.hide()
            self.header_labels[group] = lbl

        for item in self.items:
            b = QPushButton(item["name"])
            b.setIcon(QIcon.fromTheme(item["icon"]))
            b.setIconSize(QSize(26, 26))
            b.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
            b.setFixedWidth(260)
            b.setMinimumWidth(0)
            b.setStyleSheet("""
                QPushButton { text-align: left; padding: 8px 10px; border: 1px solid #ccc;
                              border-radius: 8px; background: palette(base); color: palette(text); font-size: 9.5pt; }
                QPushButton:hover { border-color: #2a7fca; }
            """)
            b.setFixedHeight(58)
            b.clicked.connect(lambda _=False, e=item["exec"], n=item: self.launch(e, n))
            self.buttons.append((item, b))
            self.button_map[id(item)] = b

        self.reflow("")

    def filter(self, text):
        self.reflow(text.lower())

    def reflow(self, needle):
        while self.grid.count():
            w = self.grid.takeAt(0).widget()
            if w is not None:
                w.hide()
        for lbl in self.header_labels.values():
            lbl.hide()

        self._visible = []
        row = 0
        for group in GROUPS:
            items = [it for it, _b in self.buttons
                     if it["group"] == group and needle in it["name"].lower()]
            if not items:
                continue
            head = self.header_labels[group]
            self.grid.addWidget(head, row, 0, 1, 3)
            head.show()
            row += 1
            col = 0
            for item in items:
                b = self.button_map[id(item)]
                self.grid.addWidget(b, row, col)
                b.show()
                self._visible.append(b)
                col += 1
                if col == 3:
                    col = 0
                    row += 1
            if col:
                row += 1
        self.grid.setRowStretch(row, 1)

    def open_single(self):
        if len(self._visible) == 1:
            self._visible[0].click()

    WINDOW_STATE = os.path.expanduser("~/.cache/dapeos/settings-windows.json")

    def window_ids(self):
        try:
            out = subprocess.run(["wmctrl", "-l"], capture_output=True,
                                 text=True, timeout=2).stdout
            return {line.split(None, 1)[0] for line in out.splitlines() if line.strip()}
        except Exception:
            return set()

    def read_window_state(self):
        try:
            with open(self.WINDOW_STATE, encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    def write_window_state(self, state):
        try:
            os.makedirs(os.path.dirname(self.WINDOW_STATE), exist_ok=True)
            tmp = self.WINDOW_STATE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(state, f)
            os.replace(tmp, self.WINDOW_STATE)
        except Exception:
            pass

    def activate_registered(self, key):
        state = self.read_window_state()
        wid = state.get(key)
        if not wid:
            return False
        if wid in self.window_ids():
            subprocess.run(["wmctrl", "-ia", wid],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        state.pop(key, None)
        self.write_window_state(state)
        return False

    def wait_new_window(self, key, before):
        for _ in range(20):
            time.sleep(0.1)
            after = self.window_ids()
            new = list(after - before)
            if new:
                wid = new[-1]
                state = self.read_window_state()
                state[key] = wid
                self.write_window_state(state)
                return True
        return False

    def focus_pid(self, pid):
        try:
            windows = subprocess.run(
                ["wmctrl", "-lp"], capture_output=True, text=True, timeout=2).stdout
            for line in windows.splitlines():
                parts = line.split(None, 3)
                if len(parts) >= 3 and parts[2] == str(pid):
                    subprocess.run(["wmctrl", "-ia", parts[0]],
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                    return True
        except Exception:
            pass
        return False

    def focus_existing(self, args, item=None):
        import re
        if not args:
            return False
        # skip env assignments and shell wrappers
        i = 0
        while i < len(args):
            base = os.path.basename(args[i])
            if base == "env":
                i += 1
                while i < len(args) and "=" in args[i] and not args[i].startswith("-"):
                    i += 1
                continue
            break
        if i >= len(args):
            return False
        prog = os.path.basename(args[i])
        if not prog or prog in ("sh", "env", "bash"):
            return False
        wmclass = (item or {}).get("wmclass", "") or prog
        try:
            # 1) window class from .desktop StartupWMClass / binary
            windows = subprocess.run(
                ["wmctrl", "-lx"], capture_output=True, text=True, timeout=2).stdout
            for line in windows.splitlines():
                parts = line.split(None, 4)
                if len(parts) < 4:
                    continue
                cls = parts[3].lower()
                if wmclass.lower() in cls or prog.lower() in cls:
                    subprocess.run(["wmctrl", "-ia", parts[0]],
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                    return True
            # 2) process id -> window pid
            pattern = "(^|/)" + re.escape(prog) + "( |$)"
            pids = subprocess.run(
                ["pgrep", "-f", pattern],
                capture_output=True, text=True, timeout=2).stdout.split()
            if pids:
                windows = subprocess.run(
                    ["wmctrl", "-lp"], capture_output=True, text=True, timeout=2).stdout
                for line in windows.splitlines():
                    parts = line.split(None, 3)
                    if len(parts) >= 3 and parts[2] in pids:
                        subprocess.run(["wmctrl", "-ia", parts[0]],
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL)
                        return True
                return True
        except Exception:
            return bool(prog)
        return False

    def launch(self, command, item=None):
        args = [a for a in shlex.split(command) if not a.startswith("%")]
        if not args:
            return
        key = (item or {}).get("file", "settings")

        # 1) already known window for this card
        if self.activate_registered(key):
            return

        # 2) running launcher/process guard
        key_lock = key
        lockdir = os.path.expanduser("~/.cache/dapeos/settings-locks")
        os.makedirs(lockdir, exist_ok=True)
        lockpath = os.path.join(lockdir, key_lock + ".lock")
        fd = os.open(lockpath, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pid = None
            try:
                with open(lockpath, "r", encoding="ascii") as lf:
                    pid = lf.read().strip()
            except OSError:
                pass
            os.close(fd)
            if pid and self.focus_pid(pid):
                return
            self.focus_existing(args, item)
            return

        before = self.window_ids()
        proc = subprocess.Popen(args, start_new_session=True, pass_fds=(fd,))
        try:
            os.ftruncate(fd, 0)
            os.pwrite(fd, str(proc.pid).encode("ascii"), 0)
        except OSError:
            pass
        os.close(fd)
        if not self.wait_new_window(key, before):
            self.focus_existing(args, item)

    def center(self):
        scr = QApplication.primaryScreen().availableGeometry()
        self.move(scr.center().x() - self.width() // 2,
                  scr.center().y() - self.height() // 2)


SOCKET_NAME = "dapeos-settings-%d" % os.getuid()


def raise_existing():
    if QLocalSocket is None:
        return False
    sock = QLocalSocket()
    sock.connectToServer(SOCKET_NAME)
    if not sock.waitForConnected(250):
        return False
    sock.write(b"show")
    sock.waitForBytesWritten(250)
    sock.disconnectFromServer()
    return True


if __name__ == "__main__":
    app = QApplication(sys.argv)
    apply_theme(app)
    install_theme_watch(app)
    QIcon.setThemeName("DapeOS")

    if raise_existing():
        sys.exit(0)

    w = SettingsHub()
    w.center()

    if QLocalServer is not None:
        QLocalServer.removeServer(SOCKET_NAME)
        server = QLocalServer()
        server.listen(SOCKET_NAME)
        app._settings_server = server

        def bring_to_front():
            while server.hasPendingConnections():
                conn = server.nextPendingConnection()
                conn.disconnectFromServer()
            w.showNormal()
            w.raise_()
            w.activateWindow()

        server.newConnection.connect(bring_to_front)

    w.show()
    sys.exit(app.exec_())