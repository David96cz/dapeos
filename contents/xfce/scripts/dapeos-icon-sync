#!/bin/sh
# Build one visible DapeOS theme and one hidden inverse panel theme.
set -eu
SYSTEM_THEME="$HOME/.local/share/icons/DapeOS"
PANEL_THEME="$HOME/.local/share/icons/DapeOS-Panel"
PANEL_ICONS="/usr/local/share/dapeos/panel"

rm -rf "$HOME/.local/share/icons/DapeOS.tmp."* \
       "$HOME/.local/share/icons/DapeOS-Panel.tmp."* 2>/dev/null || true

theme_name="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || true)"
case "$theme_name" in
    *[Dd]ark*) system_src="/usr/share/icons/Papirus-Dark" ;;
    *)         system_src="/usr/share/icons/Papirus-Light" ;;
esac
panel_dark="$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)"
if [ "$panel_dark" = "true" ]; then
    panel_src="/usr/share/icons/Papirus-Light"
else
    panel_src="/usr/share/icons/Papirus-Dark"
fi

build_theme() {
    src="$1"
    dest="$2"
    out_name="$3"
    out_comment="$4"
    hidden="$5"
    [ -d "$src" ] || return 0

    src_index="$src/index.theme"
    [ -f "$src_index" ] || src_index="$src/index.theme.dapeos-hidden"
    [ -f "$src_index" ] || return 0

    tmp="$dest.tmp.$$"
    rm -rf "$tmp"
    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
    mkdir -p "$tmp/scalable"

    # Full copy avoids broken symlink/theme-cache lookups in some GTK versions.
    cp -a "$src"/. "$tmp/"
    rm -f "$tmp/index.theme" "$tmp/index.theme.dapeos-hidden" "$tmp/.icon-theme.cache"

    if [ -d "$PANEL_ICONS" ]; then
        cp -f "$PANEL_ICONS"/*.svg "$tmp/scalable/" 2>/dev/null || true
    fi
    if [ -f "$tmp/scalable/edit-find.svg" ]; then
        cp -f "$tmp/scalable/edit-find.svg" "$tmp/scalable/search.svg"
        cp -f "$tmp/scalable/edit-find.svg" "$tmp/scalable/system-search.svg"
    fi

    cp "$src_index" "$tmp/index.theme"
    sed -i "s/^Name=.*/Name=$out_name/" "$tmp/index.theme"
    sed -i "s/^Comment=.*/Comment=$out_comment/" "$tmp/index.theme"
    sed -i '/^Name\[/d' "$tmp/index.theme"
    sed -i '/^Comment\[/d' "$tmp/index.theme"
    if [ "$hidden" = "1" ]; then
        sed -i '/^\[Icon Theme\]/a Hidden=true' "$tmp/index.theme"
    fi

    # Keep Papirus index structure intact. Only panel theme gets custom panel icons,
    # copied into the existing size/panel directories (not into a new scalable dir).
    if [ "$hidden" = "1" ] && [ -d "$PANEL_ICONS" ]; then
        for sz in 16x16 22x22 24x24 32x32 48x48 scalable; do
            [ -d "$tmp/$sz/panel" ] || continue
            cp -f "$PANEL_ICONS"/*.svg "$tmp/$sz/panel/" 2>/dev/null || true
        done
    fi

    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$tmp" "$dest"
    trap - EXIT HUP INT TERM
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$dest" >/dev/null 2>&1 || true
}

build_theme "$system_src" "$SYSTEM_THEME" "DapeOS" "DapeOS icon theme" 0
build_theme "$panel_src" "$PANEL_THEME" "DapeOS Panel" "DapeOS panel icons" 1
rm -rf "$HOME/.local/share/dapeos/panel-data"
xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
