#!/bin/sh
# Build cached light/dark icon trees once and switch them via symlink.
set -eu
exec 8>/tmp/dapeos-icon-sync.lock
flock -w 10 8 || exit 0

STORE="$HOME/.local/share/dapeos/iconsets"
VISIBLE="$HOME/.local/share/icons/DapeOS"
PANEL_VISIBLE="$HOME/.local/share/icons/DapeOS-Panel"
PANEL_ICONS="/usr/local/share/dapeos/panel"

theme_name="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || true)"
case "$theme_name" in
    *[Dd]ark*) want="dark" ;;
    *)         want="light" ;;
esac
panel_dark="$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)"
if [ "$panel_dark" = "true" ]; then
    panel_want="light"
else
    panel_want="dark"
fi

build_theme() {
    src="$1"; dest="$2"; out_name="$3"; out_comment="$4"; hidden="$5"
    [ -d "$src" ] || return 0
    src_index="$src/index.theme"
    [ -f "$src_index" ] || src_index="$src/index.theme.dapeos-hidden"
    [ -f "$src_index" ] || return 0
    [ -f "$dest/index.theme" ] && return 0

    tmp="$dest.tmp.$$"
    rm -rf "$tmp"
    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
    mkdir -p "$tmp"
    cp -alL "$src"/. "$tmp/" 2>/dev/null || cp -aL "$src"/. "$tmp/"
    rm -f "$tmp/index.theme" "$tmp/index.theme.dapeos-hidden" "$tmp/.icon-theme.cache"
    cp "$src_index" "$tmp/index.theme"
    sed -i "s/^Name=.*/Name=$out_name/" "$tmp/index.theme"
    sed -i "s/^Comment=.*/Comment=$out_comment/" "$tmp/index.theme"
    sed -i '/^Name\[/d' "$tmp/index.theme"
    sed -i '/^Comment\[/d' "$tmp/index.theme"
    if [ "$hidden" = "1" ]; then
        sed -i '/^\[Icon Theme\]/a Hidden=true' "$tmp/index.theme"
    fi
    if [ "$hidden" = "1" ] && [ -d "$PANEL_ICONS" ]; then
        for sz in 16x16 22x22 24x24 32x32 48x48 scalable; do
            [ -d "$tmp/$sz/panel" ] || continue
            for icon in "$PANEL_ICONS"/*.svg; do
                [ -e "$icon" ] || continue
                target="$tmp/$sz/panel/$(basename "$icon")"
                rm -f "$target"
                cp -f "$icon" "$target"
            done
        done
    fi
    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$tmp" "$dest"
    trap - EXIT HUP INT TERM
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$dest" >/dev/null 2>&1 || true
}

build_theme /usr/share/icons/Papirus-Light "$STORE/light" DapeOS "DapeOS light icon theme" 0
build_theme /usr/share/icons/Papirus-Dark  "$STORE/dark"  DapeOS "DapeOS dark icon theme" 0
build_theme /usr/share/icons/Papirus-Light "$STORE/panel-light" "DapeOS Panel" "DapeOS panel light icons" 1
build_theme /usr/share/icons/Papirus-Dark  "$STORE/panel-dark"  "DapeOS Panel" "DapeOS panel dark icons" 1

link_theme() {
    target="$1"; link="$2"
    mkdir -p "$(dirname "$link")"
    ln -sfn "$target" "$link.tmp"
    mv -Tf "$link.tmp" "$link"
}

link_theme "$STORE/$want" "$VISIBLE"
link_theme "$STORE/panel-$panel_want" "$PANEL_VISIBLE"

# force a GTK icon-theme reload without changing the visible theme name
xfconf-query -c xsettings -p /Net/IconThemeName -s hicolor 2>/dev/null || true
xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
