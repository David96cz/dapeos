#!/bin/sh
# One visible DapeOS theme for the system and one hidden inverse theme for the panel.
set -eu
SYSTEM_THEME="$HOME/.local/share/icons/DapeOS"
PANEL_THEME="$HOME/.local/share/icons/DapeOS-Panel"
PANEL_ICONS="/usr/local/share/dapeos/panel"

theme_name="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || true)"
case "$theme_name" in
    *[Dd]ark*) system_src="/usr/share/icons/Papirus-Dark" ;;
    *)         system_src="/usr/share/icons/Papirus-Light" ;;
esac

panel_dark="$(xfconf-query -c xfce4-panel -p /panels/dark-mode 2>/dev/null || true)"
if [ "$panel_dark" = "true" ]; then
    panel_src="/usr/share/icons/Papirus-Light"
else
    panel_src="/usr/share/icons/Papirus-Dark"
fi

build_theme() {
    src="$1"
    dest="$2"
    theme_name_out="$3"
    theme_comment="$4"
    hidden="$5"
    [ -d "$src" ] || return 0
    tmp="$dest.tmp.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp/scalable"

    for entry in "$src"/*; do
        [ -e "$entry" ] || continue
        name=$(basename "$entry")
        [ "$name" = "index.theme" ] && continue
        [ "$name" = "scalable" ] && continue
        ln -s "$entry" "$tmp/$name"
    done

    if [ -d "$src/scalable" ]; then
        for entry in "$src/scalable"/*; do
            [ -e "$entry" ] || continue
            ln -s "$entry" "$tmp/scalable/$(basename "$entry")"
        done
    fi
    if [ -d "$PANEL_ICONS" ]; then
        cp -f "$PANEL_ICONS"/*.svg "$tmp/scalable/" 2>/dev/null || true
    fi
    [ -f "$tmp/scalable/edit-find.svg" ] && cp -f "$tmp/scalable/edit-find.svg" "$tmp/scalable/search.svg"
    [ -f "$tmp/scalable/edit-find.svg" ] && cp -f "$tmp/scalable/edit-find.svg" "$tmp/scalable/system-search.svg"

    {
        echo '[Icon Theme]'
        echo "Name=$theme_name_out"
        echo "Comment=$theme_comment"
        echo 'Inherits=hicolor'
        if [ "$hidden" = "1" ]; then echo 'Hidden=true'; fi
        dirs="scalable"
        for d in $(sed -n 's/^Directories=//p' "$src/index.theme" 2>/dev/null | tr ',' ' '); do
            [ -n "$d" ] && dirs="$dirs,$d"
        done
        echo "Directories=$dirs"
        echo
        echo '[scalable]'
        echo 'Size=64'
        echo 'MinSize=8'
        echo 'MaxSize=512'
        echo 'Type=Scalable'
        echo 'Context=Applications'
        awk '/^\[/{n++} n>=2' "$src/index.theme" 2>/dev/null
    } > "$tmp/index.theme"

    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$tmp" "$dest"
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$dest" >/dev/null 2>&1 || true
}

build_theme "$system_src" "$SYSTEM_THEME" "DapeOS" "DapeOS icon theme" 0
rm -rf "$HOME/.local/share/icons/DapeOS-Panel"
build_theme "$panel_src" "$PANEL_THEME" "DapeOS Panel" "DapeOS panel icons" 1
rm -rf "$HOME/.local/share/dapeos/panel-data"

xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
