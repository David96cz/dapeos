#!/usr/bin/env python3
import socket
import subprocess
import sys
import time

SOCK = "/tmp/dapeos-quicksettings"

t0 = time.time()
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1.0)
    s.connect(SOCK)
    s.sendall(b"toggle")
    s.close()
    with open("/tmp/dapeos-toggle.log", "a") as f:
        f.write(f"socket ok in {int((time.time()-t0)*1000)} ms\n")
    sys.exit(0)
except OSError as e:
    with open("/tmp/dapeos-toggle.log", "a") as f:
        f.write(f"no daemon ({e}); starting app at {time.time():.3f}\n")
    subprocess.Popen(["dapeos-quicksettings"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)
