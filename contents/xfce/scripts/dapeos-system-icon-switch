#!/bin/sh
# Fast system icon switch: only changes a symlink and emits GTK theme events.
set -eu
STORE="$HOME/.local/share/dapeos/iconsets"
VISIBLE="$HOME/.local/share/icons/DapeOS"
theme_name="$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || true)"
case "$theme_name" in
    *[Dd]ark*) want="dark" ;;
    *)         want="light" ;;
esac
target="$STORE/$want"
[ -f "$target/index.theme" ] || exit 0

mkdir -p "$(dirname "$VISIBLE")"
ln -sfn "$target" "$VISIBLE.tmp"
mv -Tf "$VISIBLE.tmp" "$VISIBLE"

# notify running GTK apps without changing the visible theme name
xfconf-query -c xsettings -p /Net/IconThemeName -s hicolor 2>/dev/null || true
xfconf-query -c xsettings -p /Net/IconThemeName -s DapeOS 2>/dev/null || true
