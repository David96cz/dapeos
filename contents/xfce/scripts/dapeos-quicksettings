#!/usr/bin/env python3
import os
import subprocess
import sys
import time

from PyQt5.QtCore import QEvent, Qt, QThread, QTimer, pyqtSignal
from PyQt5.QtGui import QCursor, QIcon
from PyQt5.QtNetwork import QLocalServer, QLocalSocket
from PyQt5.QtWidgets import (
    QApplication, QFrame, QGridLayout, QHBoxLayout, QInputDialog, QLabel,
    QLineEdit, QPushButton, QSlider, QVBoxLayout, QWidget,
)

ACCENT = "#2a7fca"
SERVER = "dapeos-quicksettings"


def sh(cmd, timeout=4):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""


def panel_dark():
    props = sh(["xfconf-query", "-c", "xfce4-panel", "-l"])
    for prop in props.splitlines():
        if prop.endswith("/dark-mode"):
            return sh(["xfconf-query", "-c", "xfce4-panel", "-p", prop]) == "true"
    return True


def gather():
    t0 = time.time()
    wifi_on = sh(["nmcli", "-t", "-f", "WIFI", "radio"]) == "enabled"
    ssid = None
    if wifi_on:
        for line in sh(["nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi"]).splitlines():
            p = line.split(":")
            if p and p[0] == "yes" and len(p) > 1:
                ssid = p[1]
                break
    bt = "Powered: yes" in sh(["bluetoothctl", "show"])
    vol = 0
    for tok in sh(["pactl", "get-sink-volume", "@DEFAULT_SINK@"]).split():
        if tok.endswith("%"):
            try:
                vol = int(tok[:-1])
            except ValueError:
                pass
    mute = "yes" in sh(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
    try:
        cur = int(sh(["brightnessctl", "get"]))
        mx = int(sh(["brightnessctl", "max"]))
    except ValueError:
        cur, mx = 0, 0
    cap, status = None, ""
    for name in os.listdir("/sys/class/power_supply"):
        if name.startswith("BAT"):
            base = "/sys/class/power_supply/" + name
            try:
                cap = int(open(base + "/capacity").read().strip())
                status = open(base + "/status").read().strip()
            except Exception:
                pass
            break
    return {
        "dark": panel_dark(),
        "wifi_on": wifi_on, "ssid": ssid, "bt": bt, "vol": vol, "mute": mute,
        "bri": cur, "bri_max": mx, "cap": cap, "status": status,
        "night": bool(sh(["pgrep", "-x", "redshift"])),
        "ms": int((time.time() - t0) * 1000),
    }


class StateWorker(QThread):
    done = pyqtSignal(dict)
    def run(self):
        self.done.emit(gather())


class ScanWorker(QThread):
    done = pyqtSignal(list)
    def run(self):
        out = sh(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list"], timeout=10)
        seen, rows = set(), []
        for line in out.splitlines():
            p = line.split(":")
            if len(p) < 3 or not p[1] or p[1] in seen:
                continue
            seen.add(p[1])
            rows.append({"active": p[0] == "*", "ssid": p[1],
                         "signal": p[2], "sec": p[3] if len(p) > 3 else ""})
        self.done.emit(rows)


class CmdWorker(QThread):
    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd
    def run(self):
        sh(self.cmd, timeout=15)


class Tile(QPushButton):
    def __init__(self, title):
        super().__init__()
        self.setObjectName("tile")
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumHeight(70)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(12, 10, 12, 10)
        lay.setSpacing(2)
        self.t = QLabel(title)
        self.t.setObjectName("tileTitle")
        self.s = QLabel("")
        self.s.setObjectName("tileSub")
        lay.addWidget(self.t)
        lay.addWidget(self.s)

    def set_sub(self, text):
        self.s.setText(text)

    def set_active(self, active):
        self.setProperty("active", "true" if active else "false")
        self.style().unpolish(self)
        self.style().polish(self)


class QuickSettings(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.state = {"vol": 0, "bri": 0, "bri_max": 0, "dark": None}
        self.worker = None
        self.scan = None
        self.cmd_workers = []
        self.vol_timer = QTimer(self)
        self.vol_timer.setSingleShot(True)
        self.vol_timer.timeout.connect(self.push_volume)
        self.bri_timer = QTimer(self)
        self.bri_timer.setSingleShot(True)
        self.bri_timer.timeout.connect(self.push_brightness)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        root = QFrame()
        root.setObjectName("root")
        outer.addWidget(root)
        self.stack = QVBoxLayout(root)
        self.stack.setContentsMargins(16, 16, 16, 14)
        self.stack.setSpacing(12)

        self.main = QWidget()
        self.build_main()
        self.stack.addWidget(self.main)

        self.wifi = QWidget()
        self.build_wifi()
        self.wifi.hide()
        self.stack.addWidget(self.wifi)

        self.setFixedWidth(380)
        self.apply_theme(True)
        QApplication.instance().installEventFilter(self)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2500)
        self.refresh()

    def apply_theme(self, dark):
        if dark:
            bg, tile, border, text, sub = "#1f1f1f", "#2b2b2b", "#3a3a3a", "#e8e8e8", "#9a9a9a"
        else:
            bg, tile, border, text, sub = "#f5f5f5", "#ffffff", "#dcdcdc", "#1a1a1a", "#6b7280"
        self.setStyleSheet(f"""
            QFrame#root {{ background: {bg}; border-radius: 14px; }}
            QLabel {{ color: {text}; }}
            QPushButton#tile {{ background: {tile}; border: 1px solid {border}; border-radius: 10px; text-align: left; }}
            QPushButton#tile:hover {{ background: {tile}; border-color: {ACCENT}; }}
            QPushButton#tile[active="true"] {{ background: {ACCENT}; border-color: {ACCENT}; }}
            QPushButton#tile[active="true"] QLabel {{ color: white; }}
            QLabel#tileTitle {{ font-size: 10pt; font-weight: bold; }}
            QLabel#tileSub {{ font-size: 8.5pt; color: {sub}; }}
            QPushButton#tile[active="true"] QLabel#tileSub {{ color: #dbeafe; }}
            QSlider::groove:horizontal {{ height: 6px; background: {border}; border-radius: 3px; }}
            QSlider::handle:horizontal {{ width: 16px; margin: -6px 0; border-radius: 8px; background: {ACCENT}; }}
            QSlider::sub-page:horizontal {{ background: {ACCENT}; border-radius: 3px; }}
            QPushButton#flat {{ background: transparent; border: none; color: {text}; padding: 6px; }}
            QPushButton#flat:hover {{ background: {tile}; border-radius: 6px; }}
            QPushButton#back {{ background: transparent; border: none; color: {sub}; }}
        """)

    def build_main(self):
        lay = QVBoxLayout(self.main)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(12)
        grid = QGridLayout()
        grid.setSpacing(10)
        self.t_wifi = Tile("Wi-Fi")
        self.t_wifi.clicked.connect(self.show_wifi)
        self.t_bt = Tile("Bluetooth")
        self.t_bt.clicked.connect(self.toggle_bt)
        self.t_night = Tile("Noční světlo")
        self.t_night.clicked.connect(self.toggle_night)
        grid.addWidget(self.t_wifi, 0, 0)
        grid.addWidget(self.t_bt, 0, 1)
        grid.addWidget(self.t_night, 1, 0)
        lay.addLayout(grid)

        row = QHBoxLayout()
        row.addWidget(QLabel("Zvuk"))
        self.vol = QSlider(Qt.Horizontal)
        self.vol.setRange(0, 100)
        self.vol.valueChanged.connect(lambda _: self.vol_timer.start(80))
        row.addWidget(self.vol, 1)
        self.vol_lbl = QLabel("")
        row.addWidget(self.vol_lbl)
        lay.addLayout(row)

        row = QHBoxLayout()
        row.addWidget(QLabel("Jas"))
        self.bri = QSlider(Qt.Horizontal)
        self.bri.setRange(0, 100)
        self.bri.valueChanged.connect(lambda _: self.bri_timer.start(80))
        row.addWidget(self.bri, 1)
        self.bri_lbl = QLabel("")
        row.addWidget(self.bri_lbl)
        lay.addLayout(row)

        foot = QHBoxLayout()
        self.batt = QLabel("")
        foot.addWidget(self.batt)
        foot.addStretch(1)
        for text, cmd in (("Mixér", ["pavucontrol"]),
                          ("Sítě", ["nm-connection-editor"]),
                          ("Nastavení", ["xfce4-settings-manager"])):
            b = QPushButton(text)
            b.setObjectName("flat")
            b.clicked.connect(lambda _=False, c=cmd: subprocess.Popen(c))
            foot.addWidget(b)
        lay.addLayout(foot)

    def build_wifi(self):
        lay = QVBoxLayout(self.wifi)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(8)
        top = QHBoxLayout()
        back = QPushButton("< Zpět")
        back.setObjectName("back")
        back.clicked.connect(self.show_main)
        top.addWidget(back)
        top.addStretch(1)
        self.radio = QPushButton("")
        self.radio.setObjectName("flat")
        self.radio.clicked.connect(self.toggle_wifi)
        top.addWidget(self.radio)
        lay.addLayout(top)
        self.wifi_list = QVBoxLayout()
        self.wifi_list.setSpacing(4)
        lay.addLayout(self.wifi_list)
        lay.addStretch(1)

    def refresh(self):
        if self.worker and self.worker.isRunning():
            return
        self.worker = StateWorker()
        self.worker.done.connect(self.apply)
        self.worker.start()

    def apply(self, s):
        if s.get("dark") is not None and s["dark"] != self.state.get("dark"):
            self.apply_theme(s["dark"])
        self.state = s
        if os.environ.get("DAPEOS_QS_DEBUG"):
            print(f"refresh {s.get('ms')} ms", file=sys.stderr)
        self.t_wifi.set_sub(s["ssid"] or ("Vypnuto" if not s["wifi_on"] else "Nepřipojeno"))
        self.t_wifi.set_active(s["wifi_on"])
        self.t_bt.set_sub("Zapnuto" if s["bt"] else "Vypnuto")
        self.t_bt.set_active(s["bt"])
        self.t_night.set_sub("Zapnuto" if s["night"] else "Vypnuto")
        self.t_night.set_active(s["night"])

        self.vol.blockSignals(True)
        self.vol.setValue(s["vol"])
        self.vol.blockSignals(False)
        self.vol_lbl.setText("ztlumeno" if s["mute"] else f"{s['vol']}%")

        if s["bri_max"]:
            pct = int(s["bri"] * 100 / s["bri_max"])
            self.bri.blockSignals(True)
            self.bri.setValue(pct)
            self.bri.blockSignals(False)
            self.bri_lbl.setText(f"{pct}%")
        else:
            self.bri.setEnabled(False)
            self.bri_lbl.setText("n/a")

        self.batt.setText("Bez baterie" if s["cap"] is None
                          else f"Baterie {s['cap']}% ({s['status']})")

    def spawn(self, cmd):
        w = CmdWorker(cmd)
        self.cmd_workers.append(w)
        w.finished.connect(lambda: self.cmd_workers.remove(w) if w in self.cmd_workers else None)
        w.start()

    def push_volume(self):
        self.spawn(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{self.vol.value()}%"])

    def push_brightness(self):
        self.spawn(["brightnessctl", "set", f"{self.bri.value()}%"])

    def toggle_bt(self):
        self.spawn(["bluetoothctl", "power", "off" if self.state.get("bt") else "on"])
        QTimer.singleShot(800, self.refresh)

    def toggle_night(self):
        if self.state.get("night"):
            subprocess.Popen(["redshift", "-x"])
        else:
            subprocess.Popen(["redshift", "-O", "3500"])
        QTimer.singleShot(600, self.refresh)

    def run_cmd(self, cmd):
        self.spawn(cmd)
        QTimer.singleShot(700, self.refresh)

    def show_wifi(self):
        self.main.hide()
        self.wifi.show()
        self.radio.setText("Vypnout Wi-Fi" if self.state.get("wifi_on") else "Zapnout Wi-Fi")
        while self.wifi_list.count():
            it = self.wifi_list.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        note = QLabel("Skenuji…")
        self.wifi_list.addWidget(note)
        if self.scan and self.scan.isRunning():
            return
        self.scan = ScanWorker()
        self.scan.done.connect(self.fill_wifi)
        self.scan.start()

    def fill_wifi(self, rows):
        while self.wifi_list.count():
            it = self.wifi_list.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        for r in rows:
            b = QPushButton(("✓ " if r["active"] else "") + r["ssid"])
            b.setObjectName("flat")
            b.setStyleSheet("text-align: left; padding: 8px;")
            b.clicked.connect(lambda _=False, s=r["ssid"], sec=r["sec"]: self.connect(s, sec))
            self.wifi_list.addWidget(b)

    def connect(self, ssid, sec):
        pwd = None
        if sec:
            pwd, ok = QInputDialog.getText(self, "Připojení", f"Heslo pro {ssid}:", QLineEdit.Password)
            if not ok:
                return
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if pwd:
            cmd += ["password", pwd]
        self.spawn(cmd)
        QTimer.singleShot(2000, self.show_wifi)

    def toggle_wifi(self):
        on = self.state.get("wifi_on")
        self.spawn(["nmcli", "radio", "wifi", "off" if on else "on"])
        QTimer.singleShot(800, self.show_wifi)

    def show_main(self):
        self.wifi.hide()
        self.main.show()
        self.refresh()

    def hide_auto(self):
        self._hidden_at = time.time()
        self.hide()

    def toggle(self):
        if time.time() - getattr(self, "_hidden_at", 0) < 0.5:
            return
        if self.isVisible():
            self.hide()
        else:
            self.show_window()

    def show_window(self):
        self.adjustSize()
        self.show()
        self.raise_()
        self.activateWindow()
        QTimer.singleShot(0, self.position)
        self.refresh()

    def position(self):
        scr = QApplication.primaryScreen().availableGeometry()
        self.move(scr.right() - self.width() - 12, scr.bottom() - self.height() - 8)

    def eventFilter(self, obj, event):
        if event.type() == QEvent.MouseButtonPress and self.isVisible():
            if not self.geometry().contains(QCursor.pos()):
                self.hide_auto()
        return False

    def focusOutEvent(self, event):
        super().focusOutEvent(event)
        QTimer.singleShot(250, self.close_if_inactive)

    def close_if_inactive(self):
        if QApplication.activeModalWidget() is not None:
            return
        if not self.isActiveWindow():
            self.hide_auto()


def main():
    app = QApplication(sys.argv)
    QIcon.setThemeName("Papirus-Light")

    sock = QLocalSocket()
    sock.connectToServer(SERVER)
    if sock.waitForConnected(150):
        sock.write(b"toggle")
        sock.flush()
        sock.waitForBytesWritten(150)
        return

    QLocalServer.removeServer(SERVER)
    server = QLocalServer()
    server.listen(SERVER)

    win = QuickSettings()
    server.newConnection.connect(lambda: win.toggle())
    win.show_window()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
