ACCENT = "#2a7fca"
LOG_FILE = "/tmp/dapeos-quicksettings.log"
CACHE_FILE = os.path.expanduser("~/.cache/dapeos/qs-state.json")
DEBUG = os.environ.get("DAPEOS_QS_DEBUG") == "1"


def load_cache():
    try:
        import json
        with open(CACHE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def save_cache(state):
    try:
        import json
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        with open(CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(state, f)
    except Exception:
        pass


def dbg(msg):
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(msg + "\n")
    except Exception:
        pass
    if DEBUG:
        print(msg, file=sys.stderr)
SERVER = "dapeos-quicksettings"
NIGHT_STATE = os.path.expanduser("~/.cache/dapeos/nightlight")
NIGHT_ON = os.path.expanduser("~/.cache/dapeos/nightlight_on")


def sh(cmd, timeout=4):
    env = dict(os.environ, LANG="C", LC_ALL="C")
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              env=env).stdout.strip()
    except Exception:
        return ""


def panel_dark():
    props = sh(["xfconf-query", "-c", "xfce4-panel", "-l"])
    for prop in props.splitlines():
        if prop.endswith("/dark-mode"):
            return sh(["xfconf-query", "-c", "xfce4-panel", "-p", prop]) == "true"
    return True


def panel_height():
    props = sh(["xfconf-query", "-c", "xfce4-panel", "-l"])
    best = 0
    for prop in props.splitlines():
        if prop.endswith("/size"):
            try:
                best = max(best, int(sh(["xfconf-query", "-c", "xfce4-panel", "-p", prop])))
            except ValueError:
                pass
    return best or 44


def net_state():
    out = sh(["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device", "status"])
    for line in out.splitlines():
        p = line.split(":")
        if len(p) >= 3 and p[1] == "connected":
            return p[0], p[2]
    return None, None


def night_state():
    temp = 6500
    try:
        with open(NIGHT_STATE) as f:
            temp = int(f.read().strip())
    except Exception:
        pass
    return temp, os.path.exists(NIGHT_ON)


def battery_state():
    for name in os.listdir("/sys/class/power_supply"):
        if name.startswith("BAT"):
            base = "/sys/class/power_supply/" + name
            try:
                cap = int(open(base + "/capacity").read().strip())
                status = open(base + "/status").read().strip()
                return cap, status
            except Exception:
                pass
    return None, ""


def gather():
    net_type, net_name = net_state()
    wifi_on = sh(["nmcli", "-t", "-f", "WIFI", "radio"]) == "enabled"
    bt_on = "Powered: yes" in sh(["bluetoothctl", "show"])
    vol = 0
    for tok in sh(["pactl", "get-sink-volume", "@DEFAULT_SINK@"]).split():
        if tok.endswith("%"):
            try:
                vol = int(tok[:-1])
            except ValueError:
                pass
    mute = "yes" in sh(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
    try:
        cur = int(sh(["brightnessctl", "get"]))
        mx = int(sh(["brightnessctl", "max"]))
    except ValueError:
        cur, mx = 0, 0
    cap, status = battery_state()
    nt, non = night_state()
    return {"dark": panel_dark(), "net_type": net_type, "net_name": net_name,
            "wifi_on": wifi_on, "bt": bt_on, "vol": vol, "mute": mute,
            "bri": cur, "bri_max": mx, "cap": cap, "status": status,
            "night_temp": nt, "night_on": non}


class StateWorker(QThread):
    done = pyqtSignal(dict)
    def run(self):
        self.done.emit(gather())


class CmdWorker(QThread):
    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd
    def run(self):
        sh(self.cmd, timeout=20)


def icon_path(name, dark):
    if dark:
        return f"/usr/share/icons/Papirus-Panel/scalable/{name}.svg"
    return f"/usr/share/icons/Papirus-Light/22x22/panel/{name}.svg"


def make_icon(name, dark, size=20):
    lbl = QLabel()
    path = icon_path(name, dark)
    ic = QIcon(path) if os.path.exists(path) else QIcon.fromTheme(name)
    if not ic.isNull():
        lbl.setPixmap(ic.pixmap(size, size))
    lbl.setFixedWidth(size + 4)
    return lbl


class PasswordDialog(QDialog):
    def __init__(self, parent, ssid):
        super().__init__(parent)
        self.setWindowFlags(Qt.Dialog | Qt.FramelessWindowHint)
        self.setModal(True)
        bg = "#2f2f2f" if parent.state.get("dark", True) else "#f5f5f5"
        self.setStyleSheet(parent.styleSheet() + f"QDialog {{ background: {bg}; }}")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(18, 18, 18, 14)
        title = QLabel(f"Heslo pro {ssid}")
        title.setStyleSheet("font-weight: bold; font-size: 11pt;")
        lay.addWidget(title)
        self.pw = QLineEdit()
        self.pw.setEchoMode(QLineEdit.Password)
        self.pw.setPlaceholderText("Zadej heslo")
        lay.addWidget(self.pw)
        self.show_cb = QCheckBox("Zobrazit heslo")
        self.show_cb.toggled.connect(self._toggle)
        lay.addWidget(self.show_cb)
        row = QHBoxLayout()
        row.addStretch(1)
        cancel = QPushButton("Zrušit")
        cancel.clicked.connect(self.reject)
        ok = QPushButton("Připojit")
        ok.setObjectName("toggle")
        ok.clicked.connect(self.accept)
        row.addWidget(cancel)
        row.addWidget(ok)
        lay.addLayout(row)

    def _toggle(self, on):
        self.pw.setEchoMode(QLineEdit.Normal if on else QLineEdit.Password)

    def password(self):
        return self.pw.text()


class JumpSlider(QSlider):
    def _value_at(self, x):
        return QStyle.sliderValueFromPosition(self.minimum(), self.maximum(),
                                              x, max(1, self.width()))

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.setSliderDown(True)
            self.setValue(self._value_at(event.x()))
            self.grabMouse()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self.isSliderDown():
            self.setValue(self._value_at(event.x()))
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if self.isSliderDown():
            self.setSliderDown(False)
            self.releaseMouse()
            event.accept()
            return
        super().mouseReleaseEvent(event)


class Toggle(QPushButton):
    def __init__(self, text):
        super().__init__(text)
        self.setObjectName("toggle")
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)


class Tile(QPushButton):
    def __init__(self, title):
        super().__init__()
        self.setObjectName("tile")
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumHeight(70)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(12, 10, 12, 10)
        lay.setSpacing(2)
        self.t = QLabel(title)
        self.t.setObjectName("tileTitle")
        self.s = QLabel("")
        self.s.setObjectName("tileSub")
        lay.addWidget(self.t)
        lay.addWidget(self.s)

    def set_sub(self, text):
        self.s.setText(text)

    def set_active(self, active):
        self.setProperty("active", "true" if active else "false")
        self.style().unpolish(self)
        self.style().polish(self)


class QuickSettings(QWidget):
    def __init__(self):
        super().__init__()
        mode = os.environ.get("DAPEOS_QS_MODE", "popup")
        if mode == "popup":
            self.setWindowFlags(Qt.Popup | Qt.FramelessWindowHint)
            self.setAttribute(Qt.WA_TranslucentBackground, True)
        elif mode == "opaque":
            self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
            self.setAttribute(Qt.WA_TranslucentBackground, False)
        elif mode == "tool":
            self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
            self.setAttribute(Qt.WA_TranslucentBackground, True)
        else:
            self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
            self.setAttribute(Qt.WA_X11BypassWindowManagerHint, True)
            self.setAttribute(Qt.WA_TranslucentBackground, True)
        dbg(f"mode={mode}")
        self._xdpy = None
        if mode == "bypass":
            try:
                from Xlib import display as xdisplay
                self._xdpy = xdisplay.Display()
                self._click_timer = QTimer(self)
                self._click_timer.timeout.connect(self.poll_click)
                self._click_timer.start(60)
            except Exception:
                self._xdpy = None
        self.setFixedWidth(400)
        self.state = {"vol": 0, "bri": 0, "bri_max": 0, "dark": None, "night": 0}
        self.worker = None
        self.cmd_workers = []
        self._vol_hold = 0
        self._bri_hold = 0
        self._night_hold = 0

        self.vol_timer = QTimer(self)
        self.vol_timer.setSingleShot(True)
        self.vol_timer.timeout.connect(self.push_volume)
        self.bri_timer = QTimer(self)
        self.bri_timer.setSingleShot(True)
        self.bri_timer.timeout.connect(self.push_brightness)
        self.night_timer = QTimer(self)
        self.night_timer.setSingleShot(True)
        self.night_timer.timeout.connect(self.push_night)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        root = QFrame()
        root.setObjectName("root")
        outer.addWidget(root)
        self.stack = QVBoxLayout(root)
        self.stack.setContentsMargins(16, 16, 16, 14)
        self.stack.setSpacing(12)
        self.spinner = QLabel(root)
        self.spinner.setStyleSheet("font-size: 18pt; color: #8ab4f8; background: transparent;")
        self.spinner.hide()
        self._spin_frames = ["\u25dc", "\u25dd", "\u25de", "\u25df"]
        self._spin_i = 0
        self._spin_timer = QTimer(self)
        self._spin_timer.timeout.connect(self._spin_tick)

        self.qstack = QStackedWidget()
        self.stack.addWidget(self.qstack)

        self.main = QWidget()
        self.main_lay = QVBoxLayout(self.main)
        self.main_lay.setContentsMargins(0, 0, 0, 0)
        self.main_lay.setSpacing(12)
        self.main_lay.setAlignment(Qt.AlignTop)
        self.build_main()
        self.qstack.addWidget(self.main)

        self.pages = []
        self.wifi = self.make_page()
        self.build_wifi()
        self.bt = self.make_page()
        self.build_bt()
        self.night = self.make_page()
        self.build_night()

        for sl in (self.vol, self.bri, self.night_slider):
            sl.installEventFilter(self)

        self.apply_theme(True)

        self.base_h = 0
        cached = load_cache()
        if cached:
            try:
                self.apply(dict(cached))
            except Exception:
                pass
        self.base_h = max(w.sizeHint().height() for w in
                          (self.main, self.wifi, self.bt, self.night)) + 30
        self.fit_height(0)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2500)
        self.refresh()

    def make_page(self):
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(8)
        w._lay = lay
        self.qstack.addWidget(w)
        self.pages.append(w)
        return w

    def page_header(self, page, title):
        row = QHBoxLayout()
        back = QPushButton("< Zpět")
        back.setObjectName("back")
        back.clicked.connect(self.show_main)
        row.addWidget(back)
        lbl = QLabel(title)
        lbl.setObjectName("pageTitle")
        row.addWidget(lbl)
        row.addStretch(1)
        page._lay.addLayout(row)

    def build_main(self):
        grid = QGridLayout()
        grid.setSpacing(10)
        self.t_net = Tile("Síť")
        self.t_net.clicked.connect(self.show_wifi)
        self.t_bt = Tile("Bluetooth")
        self.t_bt.clicked.connect(self.show_bt)
        self.t_night = Tile("Noční světlo")
        self.t_night.clicked.connect(self.show_night)
        grid.addWidget(self.t_net, 0, 0)
        grid.addWidget(self.t_bt, 0, 1)
        grid.addWidget(self.t_night, 1, 0)
        self.main_lay.addLayout(grid)

        row = QHBoxLayout()
        self.mute_btn = QPushButton()
        self.mute_btn.setObjectName("flat")
        self.mute_btn.setFixedSize(36, 36)
        self.mute_btn.setIconSize(QSize(24, 24))
        self.mute_btn.setToolTip("Ztlumit / odtlumit")
        self.mute_btn.setIcon(QIcon("/usr/local/share/dapeos/panel/audio-volume-high.svg"))
        self.mute_btn.clicked.connect(self.toggle_mute)
        row.addWidget(self.mute_btn)
        self.vol = QSlider(Qt.Horizontal)
        self.vol.setRange(0, 100)
        self.vol.valueChanged.connect(self.on_volume_change)
        self.style_slider(self.vol)
        row.addWidget(self.vol, 1)
        self.vol_lbl = QLabel("")
        row.addWidget(self.vol_lbl)
        self.main_lay.addLayout(row)

        row = QHBoxLayout()
        self.bri_icon = QLabel()
        self.bri_icon.setPixmap(QIcon("/usr/local/share/dapeos/panel/brightness.svg").pixmap(24, 24))
        self.bri_icon.setFixedSize(36, 36)
        self.bri_icon.setAlignment(Qt.AlignCenter)
        row.addWidget(self.bri_icon)
        self.bri = QSlider(Qt.Horizontal)
        self.bri.setRange(1, 100)
        self.bri.valueChanged.connect(self.on_brightness_change)
        self.style_slider(self.bri)
        row.addWidget(self.bri, 1)
        self.bri_lbl = QLabel("")
        row.addWidget(self.bri_lbl)
        self.main_lay.addLayout(row)

        foot = QHBoxLayout()
        self.batt = QLabel("")
        foot.addWidget(self.batt)
        foot.addStretch(1)
        mix = QPushButton("Zvuk")
        mix.setObjectName("flat")
        mix.setFixedHeight(30)
        mix.clicked.connect(lambda: subprocess.Popen(["pavucontrol"]))
        foot.addWidget(mix)
        gear = QPushButton("\u2699")
        gear.setObjectName("flat")
        gear.setFixedSize(36, 30)
        gear.setToolTip("Nastavení")
        gear.clicked.connect(lambda: subprocess.Popen(["xfce4-settings-manager"]))
        foot.addWidget(gear)
        self.main_lay.addLayout(foot)
        self.main_lay.addStretch(1)

    def make_scroll(self):
        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFixedHeight(210)
        area.setFrameShape(QFrame.NoFrame)
        area.setStyleSheet("QScrollArea { background: transparent; }")
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        lay = QVBoxLayout(inner)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(4)
        area.setWidget(inner)
        return area, lay

    def build_wifi(self):
        self.page_header(self.wifi, "Síť")
        self.net_info = QLabel("")
        self.wifi._lay.addWidget(self.net_info)
        top = QHBoxLayout()
        self.radio = Toggle("Wi-Fi")
        self.radio.clicked.connect(self.toggle_wifi)
        top.addWidget(self.radio)
        self.radio_lbl = QLabel("")
        self.radio_lbl.setStyleSheet("color: #9a9a9a;")
        top.addWidget(self.radio_lbl)
        self.disc_btn = QPushButton("Odpojit")
        self.disc_btn.setObjectName("flat")
        self.disc_btn.clicked.connect(self.disconnect_wifi)
        top.addWidget(self.disc_btn)
        self.forget_btn = QPushButton("Zapomenout")
        self.forget_btn.setObjectName("flat")
        self.forget_btn.clicked.connect(self.forget_wifi)
        top.addWidget(self.forget_btn)
        top.addStretch(1)
        self.scan_btn = QPushButton("Obnovit")
        self.scan_btn.setObjectName("flat")
        self.scan_btn.clicked.connect(lambda: self.scan_wifi(True))
        top.addWidget(self.scan_btn)
        self.wifi._lay.addLayout(top)
        self.wifi_form = QWidget()
        fl = QVBoxLayout(self.wifi_form)
        fl.setContentsMargins(0, 0, 0, 0)
        self.form_title = QLabel("")
        self.form_title.setStyleSheet("font-weight: bold;")
        fl.addWidget(self.form_title)
        self.form_pw = QLineEdit()
        self.form_pw.setEchoMode(QLineEdit.Password)
        self.form_pw.setPlaceholderText("Zadej heslo")
        fl.addWidget(self.form_pw)
        self.form_show = QCheckBox("Zobrazit heslo")
        self.form_show.toggled.connect(lambda on: self.form_pw.setEchoMode(QLineEdit.Normal if on else QLineEdit.Password))
        fl.addWidget(self.form_show)
        self.form_err = QLabel("")
        self.form_err.setStyleSheet("color: #f44336; font-size: 8.5pt;")
        fl.addWidget(self.form_err)
        brow = QHBoxLayout()
        cancel = QPushButton("Zrušit")
        cancel.setObjectName("flat")
        cancel.clicked.connect(self.hide_form)
        ok = QPushButton("Připojit")
        ok.setObjectName("toggle")
        ok.clicked.connect(self.form_connect)
        self.form_ok = ok
        brow.addStretch(1)
        brow.addWidget(cancel)
        brow.addWidget(ok)
        fl.addLayout(brow)
