#!/bin/sh
# dapeos-panel-theme <slozka-s-barevnymi-svg>
# Tmavý panel: scalable téma z Papirus-Dark + barevné ikony.
set -eu
CUSTOM="${1:-}"
[ -n "$CUSTOM" ] && [ -d "$CUSTOM" ] || { echo "Použití: $0 <slozka-svg>" >&2; exit 1; }
BASE="/usr/share/icons/Papirus-Dark"
DST="/usr/share/icons/Papirus-Panel"
[ -d "$BASE" ] || { echo "CHYBÍ $BASE" >&2; exit 1; }

rm -rf "$DST"; mkdir -p "$DST/scalable"

for ctx in panel status apps places devices mimetypes actions categories emblems emotes; do
    d="$BASE/22x22/$ctx"; [ -d "$d" ] || continue
    for f in "$d"/*; do
        [ -e "$f" ] || continue
        n=$(basename "$f")
        [ -e "$DST/scalable/$n" ] && continue
        ln -s "$f" "$DST/scalable/$n"
    done
done

d="$BASE/22x22/symbolic"
if [ -d "$d" ]; then
    for sub in "$d"/*; do
        [ -d "$sub" ] || continue
        for f in "$sub"/*; do
            [ -e "$f" ] || continue
            n=$(basename "$f")
            [ -e "$DST/scalable/$n" ] && continue
            ln -s "$f" "$DST/scalable/$n"
        done
    done
fi

for f in "$CUSTOM"/*.svg; do
    [ -e "$f" ] || continue
    n=$(basename "$f")
    rm -f "$DST/scalable/$n"
    cp "$f" "$DST/scalable/$n"
done

for n in search system-search; do
    [ -f "$DST/scalable/edit-find.svg" ] && ln -sf edit-find.svg "$DST/scalable/$n.svg"
done

for n in blueman blueman-tray bluetooth bluetooth-active; do
    [ -f "$BASE/22x22/panel/bluetooth-active.svg" ] && \
        ln -sfn "$BASE/22x22/panel/bluetooth-active.svg" "$DST/scalable/$n.svg"
done

cat > "$DST/index.theme" <<'T'
[Icon Theme]
Name=Papirus-Panel
Inherits=Papirus-Dark
Directories=scalable

[scalable]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
T

chmod -R go+rX "$DST"
echo "Hotovo: $DST"
