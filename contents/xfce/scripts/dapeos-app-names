#!/usr/bin/env python3
"""Synchronizuje .desktop soubory: StartupNotify a české názvy dle app-names.conf."""
import glob
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SRC = "/usr/share/applications"
DST = os.path.join(HOME, ".local/share/applications")
CONF = "/usr/share/dapeos/app-names.conf"
NO_MENU = {
    "thunar-bulk-rename.desktop",
    "thunar-settings.desktop",
    "xfce4-file-manager.desktop",
    "xfce4-mail-reader.desktop",
    "xfce4-terminal-settings.desktop",
    "xfce4-web-browser.desktop",
    "xfce4-terminal-emulator.desktop",
    "xfce4-settings-editor.desktop",
    "xfce4-session-logout.desktop",
    "xfce4-clipman-settings",
    "info.desktop",
    "yad-icon-browser.desktop",
    "vim.desktop",
    "albert.desktop",
    "blueman-adapters.desktop",
    "kdesystemsettings.desktop",
    "light-locker-settings.desktop",
    "nm-connection-editor.desktop",
    "xfce4-settings-manager.desktop",
    "user-manager.desktop",
}
MOVE_TO_SYSTEM = {
    "dapeos-update.desktop",
    "blueman-manager.desktop",
    "dapeos-settings.desktop",
}
os.makedirs(DST, exist_ok=True)


def read_conf():
    data, section = {}, None
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\n")
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1]
                    data[section] = {}
                elif section and "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    data[section][k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return data


def patch_desktop(path, overrides, no_display=False):
    with open(path, encoding="utf-8", errors="ignore") as f:
        lines = f.read().splitlines()

    try:
        start = lines.index("[Desktop Entry]")
    except ValueError:
        return

    end = len(lines)
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("["):
            end = i
            break

    remaining = dict(overrides or {})
    body, seen_notify, seen_nodisplay = [], False, False
    for line in lines[start + 1:end]:
        key = line.split("=", 1)[0] if "=" in line else None
        if key in remaining:
            body.append(f"{key}={remaining.pop(key)}")
            if key == "StartupNotify":
                seen_notify = True
            continue
        if key == "StartupNotify":
            seen_notify = True
        if key == "NoDisplay":
            seen_nodisplay = True
            body.append("NoDisplay=true" if no_display else line)
            continue
        body.append(line)

    if not seen_notify:
        body.append("StartupNotify=true")
    if no_display and not seen_nodisplay:
        body.append("NoDisplay=true")
    for k, v in remaining.items():
        body.append(f"{k}={v}")

    out = lines[:start + 1] + body + lines[end:]
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def move_to_system(path):
    with open(path, encoding="utf-8", errors="ignore") as f:
        lines = f.read().splitlines()
    try:
        start = lines.index("[Desktop Entry]")
    except ValueError:
        return
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("["):
            end = i
            break
    for i in range(start + 1, end):
        if lines[i].startswith("Categories="):
            cats = [c for c in lines[i].split("=", 1)[1].split(";")
                    if c and c not in ("Settings", "DesktopSettings")]
            if "System" not in cats:
                cats.insert(0, "System")
            lines[i] = "Categories=" + ";".join(cats) + ";"
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def strip_nodisplay(path):
    with open(path, encoding="utf-8", errors="ignore") as f:
        lines = f.read().splitlines()
    try:
        start = lines.index("[Desktop Entry]")
    except ValueError:
        return
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("["):
            end = i
            break
    body = [l for l in lines[start + 1:end] if not l.startswith("NoDisplay=")]
    out = lines[:start + 1] + body + lines[end:]
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def main():
    conf = read_conf()
    for src in glob.glob(os.path.join(SRC, "*.desktop")):
        name = os.path.basename(src)
        dst = os.path.join(DST, name)
        if not os.path.exists(dst):
            try:
                shutil.copy2(src, dst)
            except OSError:
                continue
        overrides = dict(conf.get(name, {})) or None
        try:
            with open(dst, encoding="utf-8", errors="ignore") as f:
                text = f.read()
            sys_path = os.path.join(SRC, name)
            sys_hidden = False
            if os.path.exists(sys_path):
                with open(sys_path, encoding="utf-8", errors="ignore") as sf:
                    sys_hidden = "NoDisplay=true" in sf.read()
            no_display = ("X-XFCE-SettingsDialog" in text or name in NO_MENU or sys_hidden)
            patch_desktop(dst, overrides, no_display=no_display)
            if name in MOVE_TO_SYSTEM:
                strip_nodisplay(dst)
                move_to_system(dst)
        except OSError:
            pass
    subprocess.run(["update-desktop-database", DST], capture_output=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
