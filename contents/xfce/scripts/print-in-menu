#!/bin/bash
TEXTDOMAIN=dapeos
_() { gettext -d "$TEXTDOMAIN" "$1" 2>/dev/null || printf '%s' "$1"; }

SOUBOR="$1"
NAZEV=$(basename "$SOUBOR")
RAW_PRINTERS=$(lpstat -p 2>/dev/null | awk '{print $2}')

if [ -z "$RAW_PRINTERS" ]; then
    yad --error --title="$(_ 'Error')" --text="$(_ 'No printer is installed on this system!')" \
        --button="$(_ 'Open print settings'):0" --button="$(_ 'Close'):1" \
        --center --width=340 --window-icon="printer"
    [ $? -eq 0 ] && (system-config-printer >/dev/null 2>&1 &)
    exit 1
fi

PRINTER_LIST=$(echo "$RAW_PRINTERS" | tr '\n' '!')
DEFAULT_PRINTER=$(lpstat -d 2>/dev/null | awk '{print $4}')

VYSTUP=$(yad --form --title="$(_ 'Print file')" \
    --text="<big><b>$(_ 'Printing document')</b></big>\n\n$(_ 'File:'): $NAZEV" \
    --window-icon="printer" --center --width=450 \
    --field="$(_ 'Printer:'):CB" "$DEFAULT_PRINTER!$PRINTER_LIST" \
    --field="$(_ 'Copies:'):NUM" "1!1..20!1" \
    --field="$(_ 'Print quality:'):CB" "$(_ 'Normal')!$(_ 'Fast (Draft)')!$(_ 'High (Photo)')" \
    --button="$(_ 'Cancel'):1" \
    --button="$(_ 'Print'):0" \
    --separator="|")

if [ $? -ne 0 ]; then exit 0; fi

TISKARNA=$(echo "$VYSTUP" | cut -d'|' -f1)
KOPIE=$(echo "$VYSTUP" | cut -d'|' -f2)
KVALITA_TXT=$(echo "$VYSTUP" | cut -d'|' -f3)

case "$KVALITA_TXT" in
  "Fast (Draft)"|"Rychlá (Koncept)") MOJE_OPTS="-o print-quality=3" ;;
  "High (Photo)"|"Vysoká (Foto)")    MOJE_OPTS="-o print-quality=5" ;;
  *)                  MOJE_OPTS="-o print-quality=4" ;;
esac

lp -d "$TISKARNA" -n "$KOPIE" $MOJE_OPTS "$SOUBOR"

if [ $? -eq 0 ]; then
    notify-send -i printer "$(_ 'Print job sent')" "$(_ 'Printer:') $TISKARNA"
else
    yad --error --title="$(_ 'Error')" --text="$(_ 'Failed to send the print job.')" \
        --button="$(_ 'Open print settings'):0" --button="$(_ 'Close'):1" \
        --center --width=340 --window-icon="printer"
    [ $? -eq 0 ] && (system-config-printer >/dev/null 2>&1 &)
fi