#!/bin/sh
# Nastaví tapetu na všech monitorech a restartuje xfdesktop.
WALLPAPER="/usr/share/backgrounds/wallpaper.png"
LOG="/tmp/dapeos-wallpaper.log"

log() { echo "$(date +%H:%M:%S) $*" >> "$LOG"; }

[ -f "$WALLPAPER" ] || { log "chybí $WALLPAPER"; exit 0; }

# počkej na xfconf vlastnosti
i=0
while [ "$i" -lt 20 ]; do
    props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$')
    [ -n "$props" ] && break
    i=$((i + 1))
    sleep 1
done
[ -n "$props" ] || { log "žádné last-image vlastnosti"; exit 0; }

xset() {
    xfconf-query -c xfce4-desktop -p "$1" -n -t "$2" -s "$3" 2>>"$LOG" \
        || xfconf-query -c xfce4-desktop -p "$1" -t "$2" -s "$3" 2>>"$LOG"
}

# všechny monitory
monitors=$(xfconf-query -c xfce4-desktop -l 2>/dev/null \
    | grep -oE '/backdrop/screen0/[^/]+' | sort -u)

for mon in $monitors; do
    xset "$mon/image-path" string "$WALLPAPER"
    xset "$mon/last-single-image" string "$WALLPAPER"
    xset "$mon/image-show" bool true
    xset "$mon/image-style" int 4
    for ws in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "^${mon}/workspace[0-9]+/last-image$"); do
        xset "$ws" string "$WALLPAPER"
    done
    for ws in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "^${mon}/workspace[0-9]+/image-style$"); do
        xset "$ws" int 4
    done
done

# fallback: všechny last-image
for p in $props; do
    xset "$p" string "$WALLPAPER"
done

log "nastaveno pro: $monitors"

pkill -x xfdesktop 2>/dev/null
sleep 1
setsid xfdesktop >/dev/null 2>&1 < /dev/null &


