#!/bin/sh
# Při prvním přihlášení nastaví tapetu tam, kde je prázdná nebo výchozí.
# Potom uživatele nikdy nepřepisuje.
WALLPAPER="/usr/share/backgrounds/wallpaper.png"
MARKER="$HOME/.config/dapeos/wallpaper-initialized"
[ -f "$WALLPAPER" ] || exit 0
[ -f "$MARKER" ] && exit 0

# počkej, až xfdesktop vytvoří vlastnosti (max 15 s)
props=""
i=0
while [ "$i" -lt 15 ]; do
    props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$')
    [ -n "$props" ] && break
    i=$((i + 1))
    sleep 1
done
[ -n "$props" ] || exit 0

changed=0
for prop in $props; do
    cur=$(xfconf-query -c xfce4-desktop -p "$prop" 2>/dev/null)
    if [ -z "$cur" ] || [ ! -f "$cur" ] || echo "$cur" | grep -qE 'desktop-base|Default|default'; then
        xfconf-query -c xfce4-desktop -p "$prop" -s "$WALLPAPER" 2>/dev/null && changed=1
    fi
done
for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-path$'); do
    cur=$(xfconf-query -c xfce4-desktop -p "$prop" 2>/dev/null)
    if [ -z "$cur" ] || [ ! -f "$cur" ] || echo "$cur" | grep -qE 'desktop-base|Default|default'; then
        xfconf-query -c xfce4-desktop -p "$prop" -s "$WALLPAPER" 2>/dev/null && changed=1
    fi
done

if [ "$changed" = "1" ]; then
    for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-style$'); do
        xfconf-query -c xfce4-desktop -p "$prop" -s 5 2>/dev/null || true
    done
fi

xfdesktop --reload >/dev/null 2>&1 || true

mkdir -p "$HOME/.config/dapeos"
touch "$MARKER"
