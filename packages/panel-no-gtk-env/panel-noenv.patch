--- a/panel/main.c
+++ b/panel/main.c
@@ -20,6 +20,8 @@
 #ifdef HAVE_CONFIG_H
 #include "config.h"
 #endif
+
+#include <stdlib.h>
 #ifdef HAVE_XFCE_REVISION_H
 #include "xfce-revision.h"
 #endif
@@ -256,7 +258,27 @@
 
   /* we need to do this right now to be able to determine the windowing system used below */
   gtk_init (&argc, &argv);
+
+  /* DapeOS: apply GTK_THEME to the panel, then remove it from the environment
+   * so applications launched from the panel use the system theme. */
+  {
+    const gchar *gtk_theme = g_getenv ("GTK_THEME");
+    if (gtk_theme != NULL)
+      {
+        gchar **parts = g_strsplit (gtk_theme, ":", 2);
+        GtkSettings *settings = gtk_settings_get_default ();
+
+        if (parts[0] != NULL && *parts[0] != '\0')
+          g_object_set (settings, "gtk-theme-name", parts[0], NULL);
+        if (parts[1] != NULL)
+          g_object_set (settings, "gtk-application-prefer-dark-theme",
+                        g_strcmp0 (parts[1], "dark") == 0, NULL);
 
+        g_strfreev (parts);
+      }
+    unsetenv ("GTK_THEME");
+  }
+
   /* parse context options */
   context = g_option_context_new (_("[ARGUMENTS...]"));
   g_option_context_add_main_entries (context, option_entries, GETTEXT_PACKAGE);
