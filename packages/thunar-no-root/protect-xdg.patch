+/* DapeOS: protect top-level XDG folders from GUI removal/move */
+
+static gboolean
+dapeos_is_protected_top_level (GFile *file)
+{
+  static const gchar *names[] = {
+    "Desktop", "Documents", "Downloads", "Music",
+    "Pictures", "Public", "Templates", "Videos", NULL
+  };
+  const gchar *home = g_get_home_dir ();
+  gchar *path = g_file_get_path (file);
+  gboolean protected = FALSE;
 
+  if (path != NULL && home != NULL && g_str_has_prefix (path, home))
+    {
+      const gchar *rel = path + strlen (home);
+      if (*rel == G_DIR_SEPARATOR)
+        rel++;
+      if (*rel != '\0' && strchr (rel, G_DIR_SEPARATOR) == NULL)
+        {
+          for (guint i = 0; names[i] != NULL; i++)
+            if (g_strcmp0 (rel, names[i]) == 0)
+              {
+                protected = TRUE;
+                break;
+              }
+        }
+    }
+  g_free (path);
+  return protected;
+}
 
+static gboolean
+dapeos_block_protected (gpointer parent, GList *files)
+{
+  for (GList *lp = files; lp != NULL; lp = lp->next)
+    {
+      if (G_IS_FILE (lp->data) && dapeos_is_protected_top_level (G_FILE (lp->data)))
+        {
+          thunar_dialogs_show_error (parent, NULL, "%s",
+                                     _("This folder is protected and cannot be removed or moved."));
+          return TRUE;
+        }
+    }
+  return FALSE;
+}
 
