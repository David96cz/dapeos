#!/usr/bin/env python3
"""Minimal PO -> MO compiler (msgid/msgstr only)."""
import struct
import sys


def parse_po(path):
    entries = {}
    msgid = None
    msgstr = None
    mode = None
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("msgid "):
                if msgid is not None and msgstr is not None:
                    entries[msgid] = msgstr
                msgid = line[6:].strip().strip('"')
                msgstr = ""
                mode = "id"
            elif line.startswith("msgstr "):
                msgstr = line[7:].strip().strip('"')
                mode = "str"
            elif line.startswith('"'):
                value = line.strip().strip('"').replace("\\n", "\n")
                if mode == "id":
                    msgid += value
                elif mode == "str":
                    msgstr += value
    if msgid is not None and msgstr is not None:
        entries[msgid] = msgstr
    return entries


def compile_mo(entries, out):
    keys = sorted(entries)
    ids = b"".join(k.encode("utf-8") + b"\x00" for k in keys)
    strs = b"".join(entries[k].encode("utf-8") + b"\x00" for k in keys)

    orig = []
    pos = 0
    for k in keys:
        kb = k.encode("utf-8")
        orig.append((len(kb), pos))
        pos += len(kb) + 1

    trans = []
    pos = 0
    for k in keys:
        vb = entries[k].encode("utf-8")
        trans.append((len(vb), pos))
        pos += len(vb) + 1

    n = len(keys)
    keystart = 28 + 16 * n
    valstart = keystart + len(ids)
    header = struct.pack("<7I", 0x950412DE, 0, n, 28, 28 + 8 * n, 0, 0)
    orig = [(l, keystart + o) for l, o in orig]
    trans = [(l, valstart + o) for l, o in trans]
    table = b"".join(struct.pack("<2I", *e) for e in orig + trans)
    with open(out, "wb") as f:
        f.write(header + table + ids + strs)


if __name__ == "__main__":
    compile_mo(parse_po(sys.argv[1]), sys.argv[2])
