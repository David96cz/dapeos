#!/bin/sh
# papirus-panel-theme <slozka-s-barevnymi-svg>
#
# Postaví /usr/share/icons/Papirus-Panel jako JEDNO scalable téma:
#  - všechny ikony Papirus-Dark jsou odkazované (symlink) do scalable/
#  - díky Type=Scalable GTK škáluje na přesný počet pixelů (žádné skoky)
#  - barevné SVG z <slozka> přepíšou vybrané ikony
set -eu

CUSTOM="${1:-}"
if [ -z "$CUSTOM" ] || [ ! -d "$CUSTOM" ]; then
    echo "Použití: $0 <slozka-s-barevnymi-svg>" >&2
    exit 1
fi

BASE="/usr/share/icons/Papirus-Dark"
DST="/usr/share/icons/Papirus-Panel"

if [ ! -d "$BASE" ]; then
    echo "CHYBA: chybí $BASE (nainstaluj papirus-icon-theme)" >&2
    exit 1
fi

rm -rf "$DST"
mkdir -p "$DST/scalable"

# 1) všechny ikony z Papirus-Dark jako scalable (priorita kontextů)
for ctx in panel status apps places devices mimetypes actions categories emblems emotes; do
    d="$BASE/22x22/$ctx"
    [ -d "$d" ] || continue
    for f in "$d"/*; do
        [ -e "$f" ] || continue
        n="$(basename "$f")"
        [ -e "$DST/scalable/$n" ] && continue
        ln -s "$f" "$DST/scalable/$n"
    done
done

# 2) barevné ikony přepíšou symlinky
for f in "$CUSTOM"/*.svg; do
    [ -e "$f" ] || continue
    n="$(basename "$f")"
    rm -f "$DST/scalable/$n"
    cp "$f" "$DST/scalable/$n"
done

# 3) aliasy jmen, která používají launchery
for n in search system-search; do
    if [ -f "$DST/scalable/edit-find.svg" ]; then
        ln -sf edit-find.svg "$DST/scalable/$n.svg"
    fi
done

cat > "$DST/index.theme" <<THEME
[Icon Theme]
Name=Papirus-Panel
Comment=Papirus-Dark as a scalable theme with colorful panel icons
Inherits=Papirus-Dark
Directories=scalable

[scalable]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
THEME

chown -R root:root "$DST" 2>/dev/null || true
chmod -R go+rX "$DST" 2>/dev/null || true

echo "Hotovo: $DST ($(find "$DST/scalable" -type l | wc -l) odkazů, $(find "$DST/scalable" -type f | wc -l) souborů)"
