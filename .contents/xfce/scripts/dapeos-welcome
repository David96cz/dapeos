#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
dapeos-welcome - uvítací okno pro první přihlášení (styl Linux Mint).
Spuštění:
  dapeos-welcome              # ručně z menu
  dapeos-welcome --first-run  # z autostartu; podruhé už nic neudělá
"""

import os
import platform
import shutil
import subprocess
import sys

from PyQt5.QtCore import QSize, Qt, pyqtSignal
from PyQt5.QtGui import QColor, QIcon, QPixmap
from PyQt5.QtWidgets import (
    QApplication, QCheckBox, QDialog, QFrame, QGridLayout,
    QHBoxLayout, QLabel, QPushButton, QTextBrowser, QVBoxLayout,
    QWidget,
)

APP_NAME = "dapeos"
LOGO = "/usr/share/icons/hicolor/scalable/apps/dapeos-logo.svg"
CONF_DIR = os.path.expanduser("~/.config/dapeos")
FLAG = os.path.join(CONF_DIR, "welcome-done")


def icon(name, size=40):
    ic = QIcon.fromTheme(name)
    if ic.isNull() and os.path.exists(LOGO):
        ic = QIcon(LOGO)
    return ic.pixmap(QSize(size, size))


class Card(QFrame):
    clicked = pyqtSignal()

    def __init__(self, icon_name, title, subtitle):
        super().__init__()
        self.setObjectName("card")
        self.setCursor(Qt.PointingHandCursor)
        self.setAttribute(Qt.WA_Hover, True)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(14, 12, 14, 12)
        layout.setSpacing(12)

        pic = QLabel()
        pic.setPixmap(icon(icon_name))
        pic.setFixedWidth(44)
        layout.addWidget(pic, 0, Qt.AlignTop)

        text = QVBoxLayout()
        text.setSpacing(2)
        t = QLabel(title)
        t.setObjectName("cardTitle")
        s = QLabel(subtitle)
        s.setObjectName("cardSub")
        s.setWordWrap(True)
        text.addWidget(t)
        text.addWidget(s)
        layout.addLayout(text, 1)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.clicked.emit()
        super().mouseReleaseEvent(event)


class InfoDialog(QDialog):
    def __init__(self, parent, title, html):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(620, 480)

        layout = QVBoxLayout(self)
        browser = QTextBrowser()
        browser.setOpenExternalLinks(True)
        browser.setHtml(html)
        layout.addWidget(browser)

        close = QPushButton("Zavřít")
        close.clicked.connect(self.accept)
        layout.addWidget(close, 0, Qt.AlignRight)


def system_info_html():
    def read(path, default=""):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                return f.read()
        except Exception:  # noqa: BLE001
            return default

    pretty = "Debian"
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            pretty = line.split("=", 1)[1].strip().strip('"')

    cpu = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.lower().startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break

    mem_kb = 0
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            mem_kb = int(line.split()[1])
            break

    total, used, free = shutil.disk_usage("/")
    uptime = float(read("/proc/uptime", "0").split()[0])
    hours, minutes = int(uptime // 3600), int((uptime % 3600) // 60)

    rows = [
        ("Systém", pretty),
        ("Jádro", platform.release()),
        ("Prostředí", os.environ.get("XDG_CURRENT_DESKTOP", "XFCE")),
        ("Procesor", cpu or "—"),
        ("Paměť", f"{mem_kb / 1024 / 1024:.1f} GB"),
        ("Disk /", f"{used / 1024**3:.1f} z {total / 1024**3:.1f} GB"),
        ("Uptime", f"{hours} h {minutes} min"),
    ]

    html = "<h2>O systému</h2><table cellspacing='6'>"
    for key, value in rows:
        html += f"<tr><td><b>{key}</b></td><td>{value}</td></tr>"
    html += "</table>"
    return html


HELP_HTML = """
<h2>Nápověda</h2>

<h3>Kde je terminál a proč ho nepotřebuju?</h3>
<p>Většinu věcí uděláš klikáním. Terminál najdeš v menu mezi aplikacemi,
ale pro běžné používání ho potřebovat nebudeš.</p>

<h3>Jak nainstalovat program?</h3>
<p>Otevři <b>Instalátor balíků</b> nebo <b>Aktualizace</b>. Většina programů
jde nainstalovat z nabídky, bez stahování z internetu.</p>

<h3>Proč se po mně chce heslo?</h3>
<p>Heslo se ptá jen u změn systému (instalace, aktualizace, nastavení).
Je to stejné jako „Správce účtů“ ve Windows.</p>

<h3>Windows aplikace</h3>
<p>Některé programy pro Windows jdou spustit přes Wine. Zeptej se v nápovědě
na „Wine“ nebo použij instalátor podpory Windows aplikací.</p>

<h3>Tiskárna, Wi-Fi, Bluetooth</h3>
<p>Vše najdeš v <b>Nastavení</b>. Tiskárny se obvykle přidají samy.</p>
"""

SHORTCUTS_HTML = """
<h2>Klávesové zkratky</h2>
<table cellspacing='8'>
<tr><td><b>Super (Win)</b></td><td>otevře menu Start</td></tr>
<tr><td><b>Ctrl + Alt + Del</b></td><td>zámek, změna hesla, správce úloh</td></tr>
<tr><td><b>PrintScreen</b></td><td>snímek obrazovky</td></tr>
<tr><td><b>Alt + Tab</b></td><td>přepínání oken</td></tr>
<tr><td><b>Super + E</b></td><td>souborový manažer (pokud je nastaven)</td></tr>
</table>
"""


class Welcome(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(f"Vítejte v {APP_NAME}")
        self.setFixedSize(760, 640)
        self.setWindowFlags(Qt.Window | Qt.WindowTitleHint | Qt.WindowCloseButtonHint)
        self.setWindowIcon(QIcon(LOGO) if os.path.exists(LOGO) else QIcon.fromTheme("distributor-logo"))

        self.setStyleSheet("""
            QWidget { background: #f5f5f5; font-family: sans-serif; }
            QLabel#title { font-size: 24pt; font-weight: bold; color: #1f4e79; }
            QLabel#sub { font-size: 11pt; color: #555; }
            QFrame#card { background: white; border: 1px solid #ddd; border-radius: 10px; }
            QFrame#card:hover { background: #eef4fb; border-color: #2a7fca; }
            QLabel#cardTitle { font-size: 12pt; font-weight: bold; color: #222; }
            QLabel#cardSub { color: #666; }
            QPushButton { padding: 10px 18px; border-radius: 6px; border: 1px solid #ccc; background: white; }
            QPushButton#primary { background: #2a7fca; color: white; border: none; font-weight: bold; }
            QPushButton#primary:hover { background: #1f6aa8; }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 20)
        layout.setSpacing(14)

        header = QHBoxLayout()
        logo = QLabel()
        if os.path.exists(LOGO):
            logo.setPixmap(QIcon(LOGO).pixmap(QSize(64, 64)))
        header.addWidget(logo)
        titles = QVBoxLayout()
        title = QLabel(f"Vítejte v DapeOS")
        title.setObjectName("title")
        sub = QLabel("Systém, který se chová jako Windows – bez překvapení.")
        sub.setObjectName("sub")
        titles.addWidget(title)
        titles.addWidget(sub)
        header.addLayout(titles, 1)
        layout.addLayout(header)

        grid = QGridLayout()
        grid.setSpacing(12)

        cards = [
            ("folder-download", "Přesunout data z Windows",
             "Dokumenty, obrázky a hudbu z vašeho starého počítače.",
             self.migrate),
            ("system-software-update", "Aktualizace",
             "Nainstalujte dostupné aktualizace systému a aplikací.",
             self.open_updates),
            ("help-browser", "Nápověda",
             "Krátké odpovědi na první otázky.",
             self.open_help),
            ("preferences-desktop-theme", "Nastavení vzhledu",
             "Barevné téma, ikony a tapeta.",
             self.open_appearance),
            ("preferences-desktop-keyboard", "Klávesové zkratky",
             "Co dělá Super, Ctrl+Alt+Del a další.",
             self.open_shortcuts),
            ("dialog-information", "O systému",
             "Co je uvnitř a kam se obrátit o pomoc.",
             self.open_about),
        ]

        for i, (ic, t, s, cb) in enumerate(cards):
            card = Card(ic, t, s)
            card.clicked.connect(cb)
            grid.addWidget(card, i // 2, i % 2)

        layout.addLayout(grid, 1)

        footer = QHBoxLayout()
        self.dont_show = QCheckBox("Příště už nezobrazovat")
        self.dont_show.setChecked(True)
        footer.addWidget(self.dont_show)
        footer.addStretch(1)

        close = QPushButton("Zavřít")
        close.clicked.connect(self.close)
        start = QPushButton("Začít")
        start.setObjectName("primary")
        start.clicked.connect(self.close)
        footer.addWidget(close)
        footer.addWidget(start)
        layout.addLayout(footer)

    # ----------------------------------------------------------------- akce
    def migrate(self):
        InfoDialog(
            self, "Přesunout data z Windows",
            "<h2>Přesun dat z Windows</h2>"
            "<p>Průvodce připojí váš disk s Windows (jen pro čtení) a nabídne "
            "zkopírování složek <b>Dokumenty, Obrázky, Hudba, Videa a Stažené soubory</b> "
            "do domovské složky.</p>"
            "<p>V tuto chvíli je to v přípravě – data můžete zatím zkopírovat ručně "
            "přes <b>Správce souborů</b>, váš disk s Windows uvidíte v levém panelu.</p>",
        ).exec_()

    def open_updates(self):
        subprocess.Popen(["dapeos-update"])

    def open_appearance(self):
        subprocess.Popen(["xfce4-appearance-settings"])

    def open_help(self):
        InfoDialog(self, "Nápověda", HELP_HTML).exec_()

    def open_shortcuts(self):
        InfoDialog(self, "Klávesové zkratky", SHORTCUTS_HTML).exec_()

    def open_about(self):
        InfoDialog(self, "O systému", system_info_html()).exec_()

    def closeEvent(self, event):
        if self.dont_show.isChecked():
            try:
                os.makedirs(CONF_DIR, exist_ok=True)
                with open(FLAG, "w", encoding="utf-8") as f:
                    f.write("1\n")
            except Exception:  # noqa: BLE001
                pass
        event.accept()
        QApplication.instance().quit()


def main():
    app = QApplication(sys.argv)
    QIcon.setThemeName("Papirus-Light")
    QIcon.setFallbackThemeName("hicolor")

    if "--first-run" in sys.argv and os.path.exists(FLAG):
        return

    window = Welcome()
    window.show()
    app.exec_()


if __name__ == "__main__":
    main()
